;; apps/boot/boot.prn -- the clean-room fork's entry point, written in PARENA.
;;
;; The level tokens below are filled in by gen_boot_prn.py from levels/starter.json at build time, so
;; the numbers this program boots with are the level's own numbers. Still not a game loop: it makes
;; the boot decision, reads the horde's own shaping for the class it is about to spawn, reports, and
;; exits 0. No runtime parser, no renderer, no per-tick loop yet -- one honest tick of rule code.
(module shankpit/boot)
(import process)
(export shank-boot-main level-name level-width level-depth spawn-x spawn-y spawn-z
        spawn-class turn-cap distance-bias)

;; zombie_brain_rules.prn is compiled into THIS translation unit (apps/boot/BUILD.bazel extra_srcs),
;; so the boot decision is made by the same rule code the horde will run on, not a copy of it.
(export zb-turn-cap zb-distance-bias)

;; frame_rules.prn rides in the same build: the loop the program would run is the 460's, as numbers.
(export frame-total frame-check)
(export palette-check sky-check)

(defn level-name [] : I32 0)                       ;; name is a string; boot prints it as a literal
(defn level-width [] : I32 @LEVEL_WIDTH@)
(defn level-height [] : I32 @LEVEL_HEIGHT@)
(defn level-depth [] : I32 @LEVEL_DEPTH@)
(defn wall-count [] : I32 @WALL_COUNT@)
(defn spawner-count [] : I32 @SPAWNER_COUNT@)
(defn spawn-x [] : I32 @SPAWN_X@)
(defn spawn-y [] : I32 @SPAWN_Y@)
(defn spawn-z [] : I32 @SPAWN_Z@)

;; MODE_ZOMBIE (packages/common/protocol.h).
(defn boot-mode-zombie [] : I32 4)

;; The class the level's first spawner would put on the floor. 3 = BRUTE (zombie_taxonomy.h): the
;; slowest-turning, longest-reading body, so a wrong class shows up immediately in the numbers below.
(defn spawn-class [] : I32 3)
(defn turn-cap [] : I32 (zb-turn-cap (spawn-class)))
(defn distance-bias [] : I32 (zb-distance-bias (spawn-class)))


;; The sky curve, checked at the two rows that must never disagree: the top of the frame is the sky-top
;; band and the middle is the horizon. scale 234 ~= 180 / tan(37.5 deg), the 75-degree FOV at 360 rows.
(defn view-scale [] : F32 234.0)

;; Every row of the frame, not just the two sampled above.
(defn sky-scan [] : I32 (and (= (+ (band-count 0 (view-scale) 0.0 1.0)
                                   (+ (band-count 1 (view-scale) 0.0 1.0)
                                      (band-count 2 (view-scale) 0.0 1.0)))
                                360)
                            (> (band-count 2 (view-scale) 0.0 1.0) 0)
                            (> (band-count 1 (view-scale) 0.0 1.0) 0)
                            (= (band-inversions (view-scale) 0.0 1.0) 0)))
(defn sky-check [] : I32
  (if (and (= (sky-band 0.0 (view-scale) 0.0 1.0) 2)
           (= (sky-band 180.0 (view-scale) 0.0 1.0) 0)
           (<= (sky-t 0.0 (view-scale) 0.0 1.0) 1.0)
           (>= (sky-t 359.0 (view-scale) 0.0 1.0) 0.0))
    0
    1))

;; ---- the frame loop -------------------------------------------------------------------------------
;; Four frames of 16 ms: the accumulator carries nothing, so each frame is owed exactly one tick.
(defn frame-total [] : I32
  (let [a0 0
        s0 (frame-steps a0 16)
        a1 (frame-acc a0 16)
        s1 (frame-steps a1 16)
        a2 (frame-acc a1 16)
        s2 (frame-steps a2 16)
        a3 (frame-acc a2 16)
        s3 (frame-steps a3 16)]
    (+ (+ s0 s1) (+ s2 s3))))

;; A stalled frame (250 ms) is clamped to 100 ms, which is six ticks -- the budget, not 15.
(defn frame-check [] : I32
  (if (and (= (frame-total) 4)
           (= (frame-steps 0 250) (frame-budget))
           (= (frame-acc 0 250) 4))
    0
    1))


;; ---- is the level standable? ---------------------------------------------------------------------
;; The generator hands over whatever the JSON says, including nonsense. These are the properties boot
;; actually depends on before it can put a body in the arena, so they are asserted here rather than
;; discovered by falling through the floor: a real height, real geometry, a spawner to use, and that
;; spawner inside the arena's own extents.
(defn abs-i [(x : I32)] : I32 (if (< x 0) (- 0 x) x))

(defn level-check [] : I32
  (if (and (> (level-width) 0) (> (level-height) 0) (> (level-depth) 0)
           (> (wall-count) 0) (> (spawner-count) 0)
           (<= (abs-i (spawn-x)) (/ (level-width) 2))
           (<= (abs-i (spawn-z)) (/ (level-depth) 2))
           (>= (spawn-y) 0) (< (spawn-y) (level-height)))
    0
    1))


;; ---- the first motion ----------------------------------------------------------------------------
;; One body leaves the level's spawner at rest and is integrated for ten simulated seconds. The three
;; things that must hold: the loop's step is the step being integrated, the body moves downward, and the
;; floor stops it rather than letting it fall through the arena.
(defn spawn-y-mm [] : I32 (* (spawn-y) 1000))
(defn fell-one [] : I32 (fall-y (spawn-y-mm) 1))
(defn fell-ten-s [] : I32 (floor-y (fall-y (spawn-y-mm) 600)))

(defn sim-check [] : I32
  (if (and (= (tick-ms) (dt-ms))
           (= (fall-vy 1) (- 0 (gravity-per-tick)))
           (< (fell-one) (spawn-y-mm))
           (= (fell-ten-s) 0))
    0
    1))


;; ---- the horde the lobby would emit ---------------------------------------------------------------
;; wave_rules owns what a wave IS (size, cadence, cap, spawn ring); boot only checks that a first wave
;; fits inside the arena it was given. The 460 ring is 30 units around the origin, and starter.json is
;; 60x60, so on this level the ring sits exactly on the perimeter -- allowed, and worth knowing before
;; anyone expects the horde to arrive in the open.
(defn horde-size [] : I32 (wave-size-for 1))

(defn horde-check [] : I32
  (if (and (> (wave-count) 0)
           (> (horde-size) 0)
           (<= (horde-size) (wave-live-cap))
           (> (wave-spawn-radius-milli) 0)
           (<= (* 2 (wave-spawn-radius-milli)) (* (level-width) 1000))
           (<= (* 2 (wave-spawn-radius-milli)) (* (level-depth) 1000)))
    0
    1))


;; ---- where the wave stands -----------------------------------------------------------------------
;; 460's ring is 30 units and this arena is 60 wide, so the ring would sit on the wall; placement is pulled
;; one unit inside it rather than spawning bodies in masonry. That is a deliberate change from 460's
;; numbers and belongs in the log, not in a comment nobody reads.
(defn place-ring [] : I32
  (let [r (wave-spawn-radius-milli)
        h (- (/ (* (level-width) 1000) 2) 1000)]
    (if (> r h) h r)))

;; The ring is around the WORLD ORIGIN, not around the spawner: wave_rules says so in its own comment
;; ("a 30-unit ring around the world origin"), and centring it on starter.json's spawner at z=14 pushed
;; the south body to z=43 -- 13 units through the wall. The check below is what found that.
(defn hx [(i : I32)] : I32 (body-x i (place-ring) 0))
(defn hz [(i : I32)] : I32 (body-z i (place-ring) 0))
(defn inside-arena? [(v : I32) (half : I32)] : Bool (<= (abs-i v) half))

;; Wave 1's three bodies stand east, south and west, so they must face west, north and east respectively
;; (codes in packages/sim/horde_rules.prn). A body facing its own outward direction is looking at the
;; wall behind it, which is the case this check exists to catch.
(defn horde-facing-check [] : I32
  (if (and (= (body-facing 0) 3)
           (= (body-facing 1) 2)
           (= (body-facing 2) 1)
           (!= (body-facing 0) (body-facing 1))
           (!= (body-facing 1) (body-facing 2)))
    0
    1))

(defn horde-place-check [] : I32
  (let [hw (/ (* (level-width) 1000) 2)
        hd (/ (* (level-depth) 1000) 2)]
    (if (and (= (horde-size) 3)
             (inside-arena? (hx 0) hw) (inside-arena? (hz 0) hd)
             (inside-arena? (hx 1) hw) (inside-arena? (hz 1) hd)
             (inside-arena? (hx 2) hw) (inside-arena? (hz 2) hd)
             (!= (hx 0) (hx 1)) (!= (hz 1) (hz 2)) (!= (hx 0) (hx 2)))
      0
      1)))

;; ---- the wave lands -------------------------------------------------------------------------------
;; Every body starts at the spawner's height and, ten simulated seconds later, is resting on the floor --
;; and no tick in between puts any of them through it. A body that sinks is worse than one that floats:
;; the renderer draws it below the arena and every later collision test starts from a wrong position.
(defn horde-rest-check [] : I32
  (if (and (= (resting-y (spawn-y-mm) 0) (spawn-y-mm))
           (= (resting-y (spawn-y-mm) 600) 0)
           (= (floor-honoured (spawn-y-mm) 600) 1)
           (= (horde-size) 3))
    0
    1))

;; ---- what a body is made of -----------------------------------------------------------------------
;; A body's hit points come from stats_bridge, the GFD job table already ported into this stdlib, not
;; from a constant chosen here. The zombie classes are mapped onto GFD jobs deliberately: a 0 SHAMBLER
;; reads as BLM (55 hp + 8/level, the frailest row) and a 3 BRUTE as PLD (95 + 15/level, the tank row),
;; which is what makes "a brute takes more hits than a shambler" a property of the table rather than of
;; this file. The mapping is a fork choice and is stated as one.
(defn job-shambler [] : I32 3)
(defn job-brute [] : I32 6)
(defn body-level [] : I32 3)

(defn health-check [] : I32
  (if (and (> (sb-hp (job-brute) (body-level)) 0)
           (> (sb-hp (job-brute) 5) (sb-hp (job-brute) 1))
           (> (sb-hp (job-brute) 1) (sb-hp (job-shambler) 1))
           (= (sb-level 0) 1)
           (= (sb-level 999) 75))
    0
    1))

;; ---- can the horde be killed, and by what ---------------------------------------------------------
;; Hit points come from stats_bridge (job table), damage from hit_rules (this repo's own figures). The
;; claim that matters is not "damage exists" but "the weapon table discriminates": an AR round must not
;; remove a fresh shambler, a sniper round must, and it must not remove a fresh brute -- which is what
;; makes a brute a brute. A head shot triples, so an AR head shot is 60 against the shambler's 63: three
;; points short, and the check says so rather than rounding it away.
(defn shambler-hp [] : I32 (sb-hp (job-shambler) 1))
(defn brute-hp [] : I32 (sb-hp (job-brute) 1))

;; ---- combat, through the mod API only --------------------------------------------------------------
;; Boot calls combat_api.prn's verbs and nothing from hit_rules directly: the point of a mod API is that
;; the rule implementation can move without every caller moving with it, and a boot that reached around
;; the facade would not be testing the surface a mod actually has.
;;
;; The numbers are the job table's own curve (HP = base + per*(level-1)): a level-1 shambler (BLM) 55, a
;; level-1 brute (PLD) 95. A head shot is triple only when no shield is left (460's sp_phys), which the
;; API decides inside combat-damage-carried rather than trusting each caller to.
(defn hit-check [] : I32
  (if (and (= (combat-killed? 55 0 (dmg-ar) 0) 0)
           (= (combat-killed? 55 0 (dmg-magnum) 0) 0)
           (= (combat-killed? 55 0 (dmg-sniper) 0) 1)
           (= (combat-killed? 95 0 (dmg-magnum) 0) 0)
           (= (combat-killed? 95 0 (dmg-sniper) 0) 1)
           (= (combat-killed? 95 0 (dmg-missile) 0) 1)
           (= (combat-killed? 55 0 (dmg-ar) 1) 1)
           (= (combat-killed? 55 100 (dmg-sniper) 0) 0)
           (= (combat-killed? 55 100 (dmg-missile) 0) 0)
           (= (combat-killed? 55 100 200 0) 1)
           (= (combat-health-after (combat-health-after 55 0 (dmg-ar) 0) 0 (dmg-ar) 0) 15)
           (= (combat-health-after (combat-health-after (combat-health-after 55 0 (dmg-ar) 0) 0 (dmg-ar) 0)
                                  0 (dmg-ar) 0) 0)
           (= (combat-health-after 55 0 9999 0) 0)
           (= (combat-health-after 55 0 0 0) 55)
           (= (combat-health-after 55 0 -5 0) 55))
    0
    1))

;; A shielded body is a different fight, and the API is where that is decided: the shield soaks first,
;; only the remainder reaches health, and a head shot through a live shield is an ordinary hit.
(defn shield-check [] : I32
  (if (and (= (combat-shield-after 100 (dmg-ar) 0) 80)
           (= (combat-health-after 55 100 (dmg-ar) 0) 55)
           (= (combat-shield-after 30 (dmg-magnum) 0) 0)
           (= (combat-health-after 55 30 (dmg-magnum) 0) 40)
           (= (combat-health-after 55 100 (dmg-sniper) 0) 54)
           (= (combat-damage-carried 100 (dmg-ar) 1) 20)
           (= (combat-damage-carried 0 (dmg-ar) 1) 60)
           (= (combat-damage-carried 100 (dmg-sniper) 0) 101)
           (= (combat-shield-after 10 -5 0) 10)
           (= (combat-health-after 55 10 -5 0) 55))
    0
    1))

;; ---- losing the shield, and getting it back --------------------------------------------------------
;; The founder's rule: a knocked-off shield costs FOUR SECONDS of vulnerability, then comes back in ONE
;; SECOND ticks that start small and grow (FFXI's healing-tick curve -- the longer the body is left
;; alone, the more each tick is worth). Two claims boot can make without a game loop: nothing comes
;; back before 4000 ms, and what comes back after it grows. The "a hit restarts the 4 seconds" case is
;; the same function with a fresh clock, which is why there is no reset verb to forget to call.
(defn regen-tick-sum [(n : I32)] : I32
  (loop [i 0 total 0]
    (if (< i n)
      (recur (+ i 1) (+ total (combat-shield-tick-amount i)))
      total)))

;; A body at 0 shield 5 s after the hit has 3 points back (1 + 2). A 3-damage hit landed at that
;; moment eats exactly those points through combat-shield-after, so the body is at 0 again and the next
;; point is a full 4 s away -- the counter restarted, because the rule only ever asks "ms since the last
;; hit". 3999 ms later it still holds 0; at 4000 ms the first tick lands again.
(defn regen-restart-check [] : I32
  (let [before (combat-shield-after-regen 0 5000)
        after-hit (combat-shield-after before 3 0)]
    (if (and (= before 3)
             (= after-hit 0)
             (= (combat-shield-after-regen after-hit 3999) 0)
             (= (combat-shield-after-regen after-hit 4000) 1))
      0
      1)))

(defn regen-check [] : I32
  (if (and (= (combat-shield-max) 100)
           (= (combat-shield-regen-delay-ms) 4000)
           (= (combat-shield-regen-interval-ms) 1000)
           ;; the 4-second counter: full at the hit, one ms left just before the first tick, gone after
           (= (combat-shield-counter-ms 0) 4000)
           (= (combat-shield-counter-ms 3999) 1)
           (= (combat-shield-counter-ms 4000) 0)
           (= (combat-shield-counter-ms 9000) 0)
           (= (combat-shield-waiting? 0) 1)
           (= (combat-shield-waiting? 3999) 1)
           (= (combat-shield-waiting? 4000) 0)
           ;; four seconds of real vulnerability: the shield does not move
           (= (combat-shield-after-regen 0 0) 0)
           (= (combat-shield-after-regen 0 1000) 0)
           (= (combat-shield-after-regen 0 3999) 0)
           ;; the first tick lands exactly at 4000 and is worth 1
           (= (combat-shield-tick-amount 0) 1)
           (= (combat-shield-after-regen 0 4000) 1)
           (= (combat-shield-after-regen 0 4999) 1)
           ;; the ramp: 1,2,3,...,10 then flat, so the curve really starts slower than it ends
           (= (combat-shield-tick-amount 1) 2)
           (= (combat-shield-tick-amount 9) 10)
           (= (combat-shield-tick-amount 10) 10)
           (= (combat-shield-tick-amount 99) 10)
           (< (combat-shield-tick-amount 0) (combat-shield-tick-amount 9))
           ;; the running totals match the per-tick curve they summarise
           (= (regen-tick-sum 0) 0)
           (= (regen-tick-sum 1) 1)
           (= (regen-tick-sum 2) 3)
           (= (regen-tick-sum 3) 6)
           (= (regen-tick-sum 10) 55)
           (= (regen-tick-sum 11) 65)
           (= (combat-shield-after-regen 0 5000) 3)
           (= (combat-shield-after-regen 0 6000) 6)
           (= (combat-shield-after-regen 0 7000) 10)
           (= (combat-shield-after-regen 0 8000) 15)
           (= (combat-shield-after-regen 40 5000) 43)
           ;; never more than the bar: a nearly whole shield is clamped, a full one stays put
           (= (combat-shield-after-regen 95 9000) 100)
           (= (combat-shield-after-regen 100 0) 100)
           (= (combat-shield-after-regen 100 20000) 100)
           ;; a host that schedules in ticks gets rounded-up counts, never early ones (16 ms ticks)
           (= (combat-shield-regen-delay-ticks 16) 250)
           (= (combat-shield-regen-interval-ticks 16) 63)
           (= (* (combat-shield-regen-delay-ticks 16) 16) (combat-shield-regen-delay-ms))
           (= (regen-restart-check) 0))
    0
    1))

;; The REFLUX family: the two action types, the boundaries, the predicate that filters a shared log, and
;; the damage-dealt field that stops a scoreboard counting overkill.
(defn event-check [] : I32
  (if (and (= (combat-evt-hit) 129)
           (= (combat-evt-ko) 130)
           (= (combat-evt-first) 129)
           (= (combat-evt-last) 130)
           (= (combat-evt-is-combat? 129) 1)
           (= (combat-evt-is-combat? 130) 1)
           (= (combat-evt-is-combat? 128) 0)
           (= (combat-evt-is-combat? 131) 0)
           (= (combat-evt-is-combat? 1) 0)
           (= (combat-dmg-dealt 55 15) 40)
           (= (combat-dmg-dealt 55 0) 55)
           (= (combat-dmg-dealt 55 99) 0))
    0
    1))

;; The killing blow is the only one that dispatches a KO row: a corpse taking another sniper round fires
;; nothing, and a shield that eats the damage means the body was never in danger. Both are the same
;; function, so a dispatcher cannot count a death twice or call one that did not happen.
(defn death-check [] : I32
  (if (and (= (combat-ko? 55 0 (dmg-ar) 0) 0)
           (= (combat-ko? 55 0 (dmg-sniper) 0) 1)
           (= (combat-ko? 55 0 (dmg-ar) 1) 1)
           (= (combat-ko? 95 0 (dmg-magnum) 0) 0)
           (= (combat-ko? 95 0 (dmg-sniper) 0) 1)
           (= (combat-ko? 5 0 (dmg-missile) 0) 1)
           (= (combat-ko? 55 100 (dmg-sniper) 0) 0)
           (= (combat-ko? 55 100 (dmg-missile) 0) 0)
           (= (combat-ko? 0 0 (dmg-sniper) 0) 0)
           (= (combat-ko? -3 0 (dmg-sniper) 0) 0))
    0
    1))

;; ---- the mod ABI, and a real mod against it ---------------------------------------------------------
;; The standard is only real if something is written to it and called in its order. mod-check pins the
;; contract (ids, tick order, validity, fall-through); the shambler cases pin an actual character mod's
;; numbers, including both sides of its quarter-health boundary.
(defn mod-check [] : I32
  (if (and (= (hook-count) 7)
           (= (hook-at 0) (hook-on-spawn))
           (= (hook-at 1) (hook-on-tick))
           (= (hook-at 2) (hook-on-hit-dealt))
           (= (hook-at 3) (hook-on-hit-taken))
           (= (hook-at 4) (hook-on-shield))
           (= (hook-at 5) (hook-on-ko))
           ;; appended, not inserted: the six-hook order shipped unchanged
           (= (hook-at 6) (hook-on-shield-regen))
           (= (hook-at 7) -1)
           (= (hook-is-valid 10) 0)
           (= (hook-is-valid 11) 1)
           (= (hook-is-valid 16) 1)
           (= (hook-is-valid 17) 1)
           (= (hook-is-valid 18) 0)
           (= (hook-resolve 1 0) 1)
           (= (hook-resolve 0 1) 1)
           (= (hook-resolve 0 0) 0)
           ;; a positive amount is the mod's curve; 0/negative leaves the host's own tick
           (= (hook-regen-amount 1 10) 1)
           (= (hook-regen-amount 4 10) 4)
           (= (hook-regen-amount 0 10) 10)
           (= (hook-regen-amount -2 7) 7)
           ;; the mod-owned curve: a shambler's shield comes back flat at 1, never on the ramp
           (= (shambler-on-shield-regen 0) 1)
           (= (shambler-on-shield-regen 9) 1)
           (= (hook-regen-amount (shambler-on-shield-regen 9) (combat-shield-tick-amount 9)) 1)
           (= (hook-regen-amount 0 (combat-shield-tick-amount 9)) 10)
           (= (shambler-on-tick 55 55) 1000)
           (= (shambler-on-tick 14 55) 1000)
           (= (shambler-on-tick 13 55) 1250)
           (= (shambler-on-hit-taken 55 55) 0)
           (= (shambler-on-hit-taken 14 55) 0)
           (= (shambler-on-hit-taken 13 55) 1)
           (= (shambler-on-hit-taken 0 55) 0)
           (= (shambler-on-hit-dealt 0) 5)
           (= (shambler-on-hit-dealt 40) 0)
           (= (shambler-on-hit-dealt -1) 5)
           (= (shambler-on-ko) 0))
    0
    1))

;; What a death produces: a score shaped by weight class and head, and a respawn that restores exactly
;; the body's own health. A shambler (55) is light, a brute (95) is heavy -- 90 is the line.
(defn rules-check [] : I32
  (if (and (= (combat-score-for 55 0) 1)
           (= (combat-score-for 55 1) 2)
           (= (combat-score-for 95 0) 3)
           (= (combat-score-for 95 1) 6)
           (= (combat-respawn-ticks 55) 90)
           (= (combat-respawn-ticks 95) 180)
           (= (combat-respawn-hp 55) 55)
           (= (combat-respawn-hp 95) 95))
    0
    1))

(defn shank-boot-main [] : I32
  (do
    (println "SHANKPIT clean-room boot")
    (println "level: @LEVEL_NAME@ (generated from levels/starter.json)")
    (println "level: geometry and spawner inside the arena")
    (println "mode: zombies (MODE_ZOMBIE)")
    (println "tick 1: shaped by zombie_brain_rules for the spawn class")
    (println "loop: 16 ms fixed tick, at most 6 steps a frame")
    (println "render: 460 palette -- pale concrete, warm dusk sky, ten muted hues")
    (println "sky: row 0 is the top band, row 180 is the horizon")
    (println "sky: all 360 rows scanned, bands cover the frame and never invert")
    (println "sim: a body leaves the spawner, falls, and the floor stops it")
    (println "horde: wave 1 from wave_rules fits inside this arena")
    (println "horde: its 3 bodies stand inside the arena, apart from each other")
    (println "horde: each body faces the arena's middle, not the wall behind it")
    (println "horde: the wave lands, and no body sinks through the floor")
    (println "horde: every body has hit points, ordered by class and level")
    (println "horde: three AR rounds drop a shambler, one does not, and a sniper round drops a brute")
    (println "horde: a shield soaks first, and a head shot through one is an ordinary hit")
    (println "horde: a broken shield waits 4 s, then regen ticks ramp 1 to 10 a second")
    (println "horde: combat goes through combat_api, and its events are the REFLUX family 129-130")
    (println "horde: the killing hit fires the KO event once, and a corpse is not killed again")
    (println "mods: the hook ABI runs in one fixed order, and 1 means the mod handled it")
    (println "mods: shambler_mod enrages below a quarter health and bites a broken shield")
    (println "mods: a mod owns the shield regen curve, and 0 means the host default")
    (println "horde: a kill scores by weight class, doubles in the head, and respawn restores full health")
    (if (and (= (level-check) 0)
             (> (turn-cap) 0) (< (turn-cap) 2000) (> (distance-bias) 1000)
             (= (frame-check) 0) (= (palette-check) 0) (= (sky-check) 0) (>= (sky-scan) 1)
             (= (sim-check) 0) (= (horde-check) 0) (= (horde-place-check) 0) (= (horde-facing-check) 0) (= (horde-rest-check) 0) (= (health-check) 0) (= (hit-check) 0) (= (shield-check) 0) (= (regen-check) 0) (= (event-check) 0) (= (death-check) 0) (= (mod-check) 0) (= (rules-check) 0))
      (do
        (println "boot plan: the level's own spawner, zombie mode")
        0)
      1)))
