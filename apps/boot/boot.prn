;; apps/boot/boot.prn -- the clean-room fork's entry point, written in PARENA.
;;
;; The level tokens below are filled in by gen_boot_prn.py from levels/starter.json at build time, so
;; the numbers this program boots with are the level's own numbers. Still not a game loop: it makes
;; the boot decision, reads the horde's own shaping for the class it is about to spawn, reports, and
;; exits 0. No runtime parser, no renderer, no per-tick loop yet -- one honest tick of rule code.
(module shankpit/boot)
(import process)
(export shank-boot-main level-name level-width level-depth spawn-x spawn-y spawn-z
        spawn-class turn-cap distance-bias)

;; zombie_brain_rules.prn is compiled into THIS translation unit (apps/boot/BUILD.bazel extra_srcs),
;; so the boot decision is made by the same rule code the horde will run on, not a copy of it.
(export zb-turn-cap zb-distance-bias)

;; frame_rules.prn rides in the same build: the loop the program would run is the 460's, as numbers.
(export frame-total frame-check)
(export palette-check sky-check)

(defn level-name [] : I32 0)                       ;; name is a string; boot prints it as a literal
(defn level-width [] : I32 @LEVEL_WIDTH@)
(defn level-height [] : I32 @LEVEL_HEIGHT@)
(defn level-depth [] : I32 @LEVEL_DEPTH@)
(defn wall-count [] : I32 @WALL_COUNT@)
(defn spawner-count [] : I32 @SPAWNER_COUNT@)
(defn spawn-x [] : I32 @SPAWN_X@)
(defn spawn-y [] : I32 @SPAWN_Y@)
(defn spawn-z [] : I32 @SPAWN_Z@)

;; MODE_ZOMBIE (packages/common/protocol.h).
(defn boot-mode-zombie [] : I32 4)

;; The class the level's first spawner would put on the floor. 3 = BRUTE (zombie_taxonomy.h): the
;; slowest-turning, longest-reading body, so a wrong class shows up immediately in the numbers below.
(defn spawn-class [] : I32 3)
(defn turn-cap [] : I32 (zb-turn-cap (spawn-class)))
(defn distance-bias [] : I32 (zb-distance-bias (spawn-class)))


;; The sky curve, checked at the two rows that must never disagree: the top of the frame is the sky-top
;; band and the middle is the horizon. scale 234 ~= 180 / tan(37.5 deg), the 75-degree FOV at 360 rows.
(defn view-scale [] : F32 234.0)

;; Every row of the frame, not just the two sampled above.
(defn sky-scan [] : I32 (and (= (+ (band-count 0 (view-scale) 0.0 1.0)
                                   (+ (band-count 1 (view-scale) 0.0 1.0)
                                      (band-count 2 (view-scale) 0.0 1.0)))
                                360)
                            (> (band-count 2 (view-scale) 0.0 1.0) 0)
                            (> (band-count 1 (view-scale) 0.0 1.0) 0)
                            (= (band-inversions (view-scale) 0.0 1.0) 0)))
(defn sky-check [] : I32
  (if (and (= (sky-band 0.0 (view-scale) 0.0 1.0) 2)
           (= (sky-band 180.0 (view-scale) 0.0 1.0) 0)
           (<= (sky-t 0.0 (view-scale) 0.0 1.0) 1.0)
           (>= (sky-t 359.0 (view-scale) 0.0 1.0) 0.0))
    0
    1))

;; ---- the frame loop -------------------------------------------------------------------------------
;; Four frames of 16 ms: the accumulator carries nothing, so each frame is owed exactly one tick.
(defn frame-total [] : I32
  (let [a0 0
        s0 (frame-steps a0 16)
        a1 (frame-acc a0 16)
        s1 (frame-steps a1 16)
        a2 (frame-acc a1 16)
        s2 (frame-steps a2 16)
        a3 (frame-acc a2 16)
        s3 (frame-steps a3 16)]
    (+ (+ s0 s1) (+ s2 s3))))

;; A stalled frame (250 ms) is clamped to 100 ms, which is six ticks -- the budget, not 15.
(defn frame-check [] : I32
  (if (and (= (frame-total) 4)
           (= (frame-steps 0 250) (frame-budget))
           (= (frame-acc 0 250) 4))
    0
    1))


;; ---- is the level standable? ---------------------------------------------------------------------
;; The generator hands over whatever the JSON says, including nonsense. These are the properties boot
;; actually depends on before it can put a body in the arena, so they are asserted here rather than
;; discovered by falling through the floor: a real height, real geometry, a spawner to use, and that
;; spawner inside the arena's own extents.
(defn abs-i [(x : I32)] : I32 (if (< x 0) (- 0 x) x))

(defn level-check [] : I32
  (if (and (> (level-width) 0) (> (level-height) 0) (> (level-depth) 0)
           (> (wall-count) 0) (> (spawner-count) 0)
           (<= (abs-i (spawn-x)) (/ (level-width) 2))
           (<= (abs-i (spawn-z)) (/ (level-depth) 2))
           (>= (spawn-y) 0) (< (spawn-y) (level-height)))
    0
    1))


;; ---- the first motion ----------------------------------------------------------------------------
;; One body leaves the level's spawner at rest and is integrated for ten simulated seconds. The three
;; things that must hold: the loop's step is the step being integrated, the body moves downward, and the
;; floor stops it rather than letting it fall through the arena.
(defn spawn-y-mm [] : I32 (* (spawn-y) 1000))
(defn fell-one [] : I32 (fall-y (spawn-y-mm) 1))
(defn fell-ten-s [] : I32 (floor-y (fall-y (spawn-y-mm) 600)))

(defn sim-check [] : I32
  (if (and (= (tick-ms) (dt-ms))
           (= (fall-vy 1) (- 0 (gravity-per-tick)))
           (< (fell-one) (spawn-y-mm))
           (= (fell-ten-s) 0))
    0
    1))


;; ---- the horde the lobby would emit ---------------------------------------------------------------
;; wave_rules owns what a wave IS (size, cadence, cap, spawn ring); boot only checks that a first wave
;; fits inside the arena it was given. The 460 ring is 30 units around the origin, and starter.json is
;; 60x60, so on this level the ring sits exactly on the perimeter -- allowed, and worth knowing before
;; anyone expects the horde to arrive in the open.
(defn horde-size [] : I32 (wave-size-for 1))

(defn horde-check [] : I32
  (if (and (> (wave-count) 0)
           (> (horde-size) 0)
           (<= (horde-size) (wave-live-cap))
           (> (wave-spawn-radius-milli) 0)
           (<= (* 2 (wave-spawn-radius-milli)) (* (level-width) 1000))
           (<= (* 2 (wave-spawn-radius-milli)) (* (level-depth) 1000)))
    0
    1))


;; ---- where the wave stands -----------------------------------------------------------------------
;; 460's ring is 30 units and this arena is 60 wide, so the ring would sit on the wall; placement is pulled
;; one unit inside it rather than spawning bodies in masonry. That is a deliberate change from 460's
;; numbers and belongs in the log, not in a comment nobody reads.
(defn place-ring [] : I32
  (let [r (wave-spawn-radius-milli)
        h (- (/ (* (level-width) 1000) 2) 1000)]
    (if (> r h) h r)))

;; The ring is around the WORLD ORIGIN, not around the spawner: wave_rules says so in its own comment
;; ("a 30-unit ring around the world origin"), and centring it on starter.json's spawner at z=14 pushed
;; the south body to z=43 -- 13 units through the wall. The check below is what found that.
(defn hx [(i : I32)] : I32 (body-x i (place-ring) 0))
(defn hz [(i : I32)] : I32 (body-z i (place-ring) 0))
(defn inside-arena? [(v : I32) (half : I32)] : Bool (<= (abs-i v) half))

;; Wave 1's three bodies stand east, south and west, so they must face west, north and east respectively
;; (codes in packages/sim/horde_rules.prn). A body facing its own outward direction is looking at the
;; wall behind it, which is the case this check exists to catch.
(defn horde-facing-check [] : I32
  (if (and (= (body-facing 0) 3)
           (= (body-facing 1) 2)
           (= (body-facing 2) 1)
           (!= (body-facing 0) (body-facing 1))
           (!= (body-facing 1) (body-facing 2)))
    0
    1))

(defn horde-place-check [] : I32
  (let [hw (/ (* (level-width) 1000) 2)
        hd (/ (* (level-depth) 1000) 2)]
    (if (and (= (horde-size) 3)
             (inside-arena? (hx 0) hw) (inside-arena? (hz 0) hd)
             (inside-arena? (hx 1) hw) (inside-arena? (hz 1) hd)
             (inside-arena? (hx 2) hw) (inside-arena? (hz 2) hd)
             (!= (hx 0) (hx 1)) (!= (hz 1) (hz 2)) (!= (hx 0) (hx 2)))
      0
      1)))

(defn shank-boot-main [] : I32
  (do
    (println "SHANKPIT clean-room boot")
    (println "level: @LEVEL_NAME@ (generated from levels/starter.json)")
    (println "level: geometry and spawner inside the arena")
    (println "mode: zombies (MODE_ZOMBIE)")
    (println "tick 1: shaped by zombie_brain_rules for the spawn class")
    (println "loop: 16 ms fixed tick, at most 6 steps a frame")
    (println "render: 460 palette -- pale concrete, warm dusk sky, ten muted hues")
    (println "sky: row 0 is the top band, row 180 is the horizon")
    (println "sky: all 360 rows scanned, bands cover the frame and never invert")
    (println "sim: a body leaves the spawner, falls, and the floor stops it")
    (println "horde: wave 1 from wave_rules fits inside this arena")
    (println "horde: its 3 bodies stand inside the arena, apart from each other")
    (println "horde: each body faces the arena's middle, not the wall behind it")
    (if (and (= (level-check) 0)
             (> (turn-cap) 0) (< (turn-cap) 2000) (> (distance-bias) 1000)
             (= (frame-check) 0) (= (palette-check) 0) (= (sky-check) 0) (>= (sky-scan) 1)
             (= (sim-check) 0) (= (horde-check) 0) (= (horde-place-check) 0) (= (horde-facing-check) 0))
      (do
        (println "boot plan: the level's own spawner, zombie mode")
        0)
      1)))
