load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:parena.bzl", "parena_binary")

# levels/starter.json -> shank_boot.prn: the boot program's constants are the level's own numbers.
genrule(
    name = "boot_prn",
    srcs = [
        "boot.prn",
        "//levels:starter.json",
    ],
    outs = ["shank_boot.prn"],
    tools = ["gen_boot_prn.py"],
    cmd = "python3 $(location gen_boot_prn.py) $(location boot.prn) $(location //levels:starter.json) $@",
    visibility = ["//visibility:private"],
)

# The program's whole translation unit is emitted by PARENA; `main` is appended by the macro.
# zombie_brain_rules.prn rides in the same build so boot calls the real rule code, not a copy.
parena_binary(
    name = "shank_boot",
    src = ":boot_prn",
    entry = "shank_boot_main",
    extra_srcs = [
        "@parena//stdlib:shankpit/zombie_brain_rules.prn",
        "//packages/frame:frame_rules.prn",
        "//packages/render:palette_rules.prn",
        "//packages/render:sky_rules.prn",
        "//packages/sim:fall_rules.prn",
    ],
    deps = ["@parena//runtime:parena_runtime"],
)

sh_test(
    name = "boot_smoke_test",
    srcs = ["//bazel:boot_smoke_test.sh"],
    data = [":shank_boot"],
    args = ["$(rootpath :shank_boot)"],
)
