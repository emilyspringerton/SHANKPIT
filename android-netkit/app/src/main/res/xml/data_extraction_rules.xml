<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the tablet: saved hosts, trusted host keys and the Keystore-wrapped passwords are excluded from cloud backup and
     from device-to-device transfer (Android 12+). Older releases are covered by allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
