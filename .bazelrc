# SHANKPIT's Bazel config. Mirrors the root Makefile's own real, exact CFLAGS
# (-O2 -Wall -D_REENTRANT) globally so every cc_library/cc_binary gets the same
# real compile flags the Makefile build already used, without repeating them
# in every BUILD.bazel file -- same real "global flags, not per-target" shape
# ECOWAR/REDGARDEN's own .bazelrc already established in this monorepo.
build --copt=-O2
build --copt=-Wall
build --copt=-D_REENTRANT
