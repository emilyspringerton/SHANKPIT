# router.conf -- settings for setup-router.sh (plain shell VAR="value" lines).
# Copy to router.conf next to the script and edit. router.conf is gitignored by
# convention: it holds the Wi-Fi passphrase, never commit it.
# This file is SOURCED by bash: keep values in SINGLE quotes if they contain $ ` \ or "
# (e.g. PASSPHRASE='pa$$w"ord'), otherwise the shell rewrites them before use.

# --- Access point (wlan0). Same SSID + passphrase as the phone hotspot so the
# iMac joins either one without reconfiguration.
SSID='CHANGE-ME-same-as-phone-hotspot'
PASSPHRASE='CHANGE-ME-8-to-63-chars'
COUNTRY="US"            # two-letter regulatory domain; must match where you are
CHANNEL="6"             # 2.4 GHz only (Pi 3 Model B v2.1 has no 5 GHz): 1, 6 or 11 are cleanest
HIDDEN_SSID="0"         # 1 = do not broadcast the SSID

# --- LAN handed out on wlan0
LAN_IP="192.168.50.1"   # the Pi's own address (gateway + DNS for clients)
LAN_PREFIX_LEN="24"     # 16..30
DHCP_START="192.168.50.100"
DHCP_END="192.168.50.199"
DHCP_LEASE="12h"

# --- The iMac: fixed address by MAC (must be inside the subnet, ideally outside the pool)
IMAC_MAC="aa:bb:cc:dd:ee:ff"
IMAC_IP="192.168.50.10"
IMAC_HOSTNAME="imac"

# --- Uplink (Android phone, USB tethering)
# Leave empty to auto-match usb0 and enx* (RNDIS/CDC). Set e.g. "enxa1b2c3d4e5f6"
# to pin one specific interface name.
TETHER_IFACE=""
# Upstream DNS used only if the tether link provides none (space separated).
DNS_FALLBACK="1.1.1.1 9.9.9.9"
# 1 = rewrite outgoing IPv4 TTL to 65 so carriers that throttle tethering by TTL
# see phone-originated traffic. Off by default; only enable if the carrier needs it.
TETHER_TTL_FIX="0"
