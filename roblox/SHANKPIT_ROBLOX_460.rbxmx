    <Item class="ModuleScript" referent="RBX1">
      <Properties>
        <string name="Name">net460</string>
        <ProtectedString name="Source">-- src/net460.lua -- the world's own numbers, read on the Roblox side.
--
-- SHANKPIT-460 DNA, narrow: this is the READ half of "web stats" -- the same fact WOTAN's Citizens page
-- renders, handed to a Roblox server. It owns no rating, no record and no order of its own; everything here
-- either mirrors the published snapshot exactly or reports that it cannot.
--
-- WHERE THE DATA COMES FROM (checked, not assumed): `packages/simulation/dw_net.c` publishes
-- `{schema, generated_ms, population, meta, records[], challenges[], results[], recent[], stage}` through
-- `tools/shankpit_netd.c` at `/api/v1/shankpit-net/deadweight`, and it is written only when the world names a
-- file (`SHANKPIT_NET_SNAPSHOT`), because a world that publishes nothing should cost nothing. So this module
-- takes an ALREADY-DECODED table (`HttpService:JSONDecode` in the place, a literal in the tests) and never
-- does HTTP itself: the network belongs to whoever calls it, which is what lets the whole thing be tested
-- without a game running.
--
-- THE SORT IS THE LADDER'S RULE, NOT A SECOND OPINION: rating desc, wins desc, pid asc -- the same total order
-- WOTAN's page sorts by and the same one `dw_stage` seeds its bracket from. The snapshot deliberately ships
-- no pre-sorted array (schema 2's own note: shipping the same fact twice is how two pages start disagreeing
-- about who is first), so sorting here is not duplication; inventing a tie-break would be.

local M = {}

-- How old a snapshot may be before a screen should say so. 15 s is ~7 publication intervals (`dw_net_publish`
-- writes at most every 2 s), so a healthy world never trips it and a dead one trips it immediately.
M.MAX_AGE_MS = 15000

-- Schema 1 had no `rating`; 2 added it; 3 added the stage bracket. Read what is there and say what is not,
-- rather than refusing an older snapshot the world may legitimately still be writing.
function M.schema(snapshot)
    if type(snapshot) ~= "table" then return 0 end
    local n = tonumber(snapshot.schema)
    if not n then return 0 end
    return math.floor(n)
end

function M.supports(snapshot)
    local s = M.schema(snapshot)
    return {
        rating = s &gt;= 2,
        stage  = s &gt;= 3,
    }
end

-- Stale means "do not draw this as live". A missing timestamp is stale (an undated number is not evidence of
-- freshness), and a timestamp in the future is treated as fresh but measured symmetrically -- a box whose clock
-- is off by an hour should not blank the board.
function M.stale(snapshot, now_ms, max_age_ms)
    if type(snapshot) ~= "table" then return true end
    local gen = tonumber(snapshot.generated_ms)
    if not gen then return true end
    local age = tonumber(now_ms) - gen
    if not age then return true end
    if age &lt; 0 then age = -age end
    return age &gt; (tonumber(max_age_ms) or M.MAX_AGE_MS)
end

-- rating desc, wins desc, pid asc. A record with no rating (schema 1, or a malformed line) sorts last rather
-- than being dropped: a body that exists with an unknown number is still a body.
function M.rank(records)
    local out = {}
    if type(records) ~= "table" then return out end
    for i = 1, #records do
        if type(records[i]) == "table" then out[#out + 1] = records[i] end
    end
    table.sort(out, function(a, b)
        local ra, rb = tonumber(a.rating), tonumber(b.rating)
        if ra ~= nil and rb ~= nil and ra ~= rb then return ra &gt; rb end
        if (ra ~= nil) ~= (rb ~= nil) then return ra ~= nil end
        local wa, wb = tonumber(a.wins) or 0, tonumber(b.wins) or 0
        if wa ~= wb then return wa &gt; wb end
        return (tonumber(a.pid) or 1e9) &lt; (tonumber(b.pid) or 1e9)
    end)
    return out
end

function M.record_for(snapshot, pid)
    if type(snapshot) ~= "table" or type(snapshot.records) ~= "table" then return nil end
    local want = tonumber(pid)
    if not want then return nil end
    for i = 1, #snapshot.records do
        local r = snapshot.records[i]
        if type(r) == "table" and tonumber(r.pid) == want then return r end
    end
    return nil
end

-- What a board header says: how many bodies, and which way the meta leans. The meta's own field names are the
-- exporter's; anything missing reads as "none" instead of a guess.
function M.population(snapshot)
    if type(snapshot) ~= "table" then return { count = 0, meta_kind = "none" } end
    local count = tonumber(snapshot.population)
    if not count then
        count = (type(snapshot.records) == "table") and #snapshot.records or 0
    end
    local kind = "none"
    if type(snapshot.meta) == "table" and snapshot.meta.kind ~= nil then
        kind = tostring(snapshot.meta.kind)
    end
    return { count = count, meta_kind = kind }
end

-- The rows a board draws, capped, with their standing. Standing is 1-based and equals the rank in `rank`, so a
-- reader never re-derives "am I third" from a rating.
function M.rows(snapshot, limit)
    local ranked = M.rank(type(snapshot) == "table" and snapshot.records or nil)
    local out = {}
    local n = #ranked
    if limit and limit &lt; n then n = limit end
    for i = 1, n do
        local r = ranked[i]
        out[#out + 1] = {
            standing = i,
            pid = tonumber(r.pid) or 0,
            name = tostring(r.name or ""),
            rating = tonumber(r.rating),
            wins = tonumber(r.wins) or 0,
            games = tonumber(r.games) or 0,
        }
    end
    return out
end

return M
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">queue460</string>
        <ProtectedString name="Source">-- src/queue460.lua -- the 460 queue: the LISTS live here, the RULES do not.
--
-- SHANKPIT-460 DNA (shankpit-460/docs2/NORTHSTAR.md, S156-03): "basic matchmaking as a simplified
-- VS2-lifecycle-shaped queue". This is that queue and nothing else -- no board, no card game, no deck, no
-- citizen life. NOOBTOPIA already owns the wide version of this world; the Roblox SHANKPIT surface is
-- deliberately the narrow one.
--
-- EVERY THRESHOLD IN HERE IS SOMEWHERE ELSE, ON PURPOSE. `queue460_rules.lua` is emitted from
-- `PARENA/stdlib/shankpit/queue_rules.prn` by `roblox/scripts/gen_queue460.sh`, so the window's base, its
-- growth, its cap, the expiry and the fill delay are typed once and compared once. What is left in this file is
-- what PARENA is not for: a list of seats, a closest-pair search, and bookkeeping. If a number ever appears in
-- this file that also appears in the .prn, the copy is the bug -- same rule `deadweight_rating.lua` and
-- `deadweight_stage.lua` already live by in NOOBTOPIA.
--
-- PURE: no network, no clock of its own (every call takes `now_ms`), no `game`, no `workspace`. That is what
-- lets `roblox/tests/queue460_test.lua` pin the numbers by hand under plain Lua.

local rules = require("queue460_rules")

local M = {}

-- Exposed so a test (or a host) can prove the module is running the generated rules rather than a stale copy.
M.RULES = rules

M.MODES = { casual = true, ranked = true }

-- Rating points of tolerance after waiting wait_ms. Delegates; kept as a function so callers never see floats
-- reach the integer rules.
function M.window(wait_ms)
    return rules.queueWindow(math.floor(tonumber(wait_ms) or 0))
end

function M.new()
    return { next_id = 1, casual = {}, ranked = {} }
end

-- One seat per body per mode: a body in casual may also queue ranked, but never twice in the same line.
function M.enqueue(q, mode, entry)
    if not M.MODES[mode] then return nil, "mode" end
    if type(entry) ~= "table" then return nil, "entry" end
    local pid = tonumber(entry.pid)
    if not pid then return nil, "pid" end
    local list = q[mode]
    for i = 1, #list do
        if list[i].pid == pid then return nil, "duplicate" end
    end
    local e = {
        id = q.next_id,
        pid = pid,
        -- 1000 is the ladder's own starting rating (`rating_start()` in
        -- PARENA/stdlib/deadweight/rating.prn); a caller that has a real one passes it.
        rating = tonumber(entry.rating) or 1000,
        name = tostring(entry.name or ""),
        joined_ms = tonumber(entry.joined_ms) or 0,
    }
    q.next_id = q.next_id + 1
    list[#list + 1] = e
    return e
end

function M.remove(q, mode, pid)
    local list = q[mode]
    if not list then return nil end
    local want = tonumber(pid)
    for i = 1, #list do
        if list[i].pid == want then
            return table.remove(list, i)
        end
    end
    return nil
end

function M.position(q, mode, pid)
    local list = q[mode]
    if not list then return nil end
    local want = tonumber(pid)
    for i = 1, #list do
        if list[i].pid == want then return i end
    end
    return nil
end

-- The closest legal pair in this line, or nil. Whether a gap is legal is `queue-gap-fits`'s call (the strict,
-- shorter-waiting window), so this only searches. Ties on the gap go to the earlier-seated body, then to the
-- lower pid -- a fixed order, so the same queue always hands back the same pair.
function M.pair(q, mode, now_ms)
    local list = q[mode]
    if not list or #list &lt; 2 then return nil end
    local bi, bj, bgap = nil, nil, nil
    for i = 1, #list - 1 do
        for j = i + 1, #list do
            local a, b = list[i], list[j]
            local gap = math.abs(a.rating - b.rating)
            if rules.queueGapFits(gap, now_ms - a.joined_ms, now_ms - b.joined_ms) == 1 then
                local better = false
                if bgap == nil then
                    better = true
                elseif gap &lt; bgap then
                    better = true
                elseif gap == bgap then
                    local cur = list[bi]
                    if a.id &lt; cur.id then better = true
                    elseif a.id == cur.id and b.id &lt; list[bj].id then better = true end
                end
                if better then bi, bj, bgap = i, j, gap end
            end
        end
    end
    if not bi then return nil end
    local second = table.remove(list, bj)
    local first = table.remove(list, bi)
    return { first = first, second = second, gap = bgap }
end

-- One tick of a line: release the expired, hand back every legal pair, and name who is fillable. Expiry and
-- fillability are the rules module's answers -- including "ranked is never fillable", which is a policy this
-- file must not be able to get wrong.
function M.tick(q, mode, now_ms)
    local out = { pairs = {}, expired = {}, fills = {} }
    local list = q[mode]
    if not list then return out end
    local i = 1
    while i &lt;= #list do
        if rules.queueExpired(now_ms - list[i].joined_ms) == 1 then
            out.expired[#out.expired + 1] = table.remove(list, i)
        else
            i = i + 1
        end
    end
    while true do
        local p = M.pair(q, mode, now_ms)
        if not p then break end
        out.pairs[#out.pairs + 1] = p
    end
    local ranked = (mode == "ranked") and 1 or 0
    for k = 1, #list do
        if rules.queueFillable(ranked, now_ms - list[k].joined_ms) == 1 then
            out.fills[#out.fills + 1] = list[k]
        end
    end
    return out
end

return M
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX3">
      <Properties>
        <string name="Name">ticket460</string>
        <ProtectedString name="Source">-- src/ticket460.lua -- reading a SHANKPIT connect ticket, and never pretending to verify one.
--
-- THE FORMAT IS CHECKED, NOT ASSUMED. `IDUNA/internal/http/handlers/shankpit_ticket.go`:
--
--   POST /api/v1/shankpit/ticket   (Bearer IDUNA JWT)
--     -&gt; {"ticket": "&lt;72 hex chars&gt;", "expires_at": &lt;unix seconds&gt;, "player_id": "&lt;uuid&gt;"}
--
-- and the ticket is 36 raw BYTES, hex-encoded:
--
--   player_id (16 bytes, raw UUID) || expires_at (4 bytes, LITTLE-endian u32) || hmac_sha256(secret, payload)[:16]
--
-- TTL is 5 minutes (`ShankpitTicketTTL`), because a ticket is presented ONCE at PACKET_CONNECT rather than held
-- for a session. An earlier version of this file invented a `s460:&lt;pid&gt;:&lt;hex&gt;` string -- there is no such
-- prefix anywhere in IDUNA, and the pid is a UUID rather than an integer; that is why this file now parses the
-- bytes above and nothing else.
--
-- WHAT THIS MODULE IS ALLOWED TO SAY, and it is deliberately little: the SHAPE is right, the expiry has or has
-- not passed, and which player it claims to be for. It does NOT verify the MAC and holds no secret -- the C
-- server holds `SHANKPIT_TICKET_SECRET` and verifies with a constant-time compare
-- (shankpit-460's `packages/common/hmac_sha256.h`). A place every client can read is the last place a signing
-- secret belongs, so the honest thing for the Roblox side to do is mint, hand over, and shut up.
--
-- The shape and expiry arithmetic are `ticket460_rules.lua`, emitted from
-- `PARENA/stdlib/shankpit/ticket_rules.prn` (`make regen-roblox-rules`) -- not restated here.

local rules = require("ticket460_rules")

local M = {}

M.RULES = rules

-- Bytes a ticket carries, and therefore the hex length. Kept for a reader; the rule itself lives in the .prn.
M.BYTES = 36

local function dashUuid(idHex)
    return string.format("%s-%s-%s-%s-%s",
        idHex:sub(1, 8), idHex:sub(9, 12), idHex:sub(13, 16), idHex:sub(17, 20), idHex:sub(21, 32))
end

-- `s460` in the old tests is gone: a real ticket is 72 hex characters and nothing else.
function M.parse(ticket)
    if type(ticket) ~= "string" then return { ok = false, reason = "not-a-ticket" } end
    local hex = ticket:lower()
    if hex:find("[^0-9a-f]") then return { ok = false, reason = "not-hex" } end
    if rules.ticketShapeOk(#hex) ~= 1 then return { ok = false, reason = "bad-length" } end

    local idHex = hex:sub(1, 32)
    local b = {}
    for i = 1, 4 do
        b[i] = tonumber(hex:sub(32 + i * 2 - 1, 32 + i * 2), 16)
    end
    -- LITTLE-endian: the first byte is the least significant, which is the order the C server reads.
    local expires = b[1] + b[2] * 256 + b[3] * 65536 + b[4] * 16777216

    return {
        ok = true,
        player_id = dashUuid(idHex),
        expires_at = expires,
        hex = hex,
    }
end

-- Shape + expiry. Omit now_s and the expiry is not judged (there is nothing honest to judge it against), which
-- is why every caller in the place passes one.
function M.usable(ticket, now_s)
    local t = M.parse(ticket)
    if not t.ok then return t end
    local now = tonumber(now_s)
    if now ~= nil then
        now = math.floor(now)
        if rules.ticketExpired(now, t.expires_at) == 1 then
            return { ok = false, reason = "expired", expires_at = t.expires_at, player_id = t.player_id }
        end
        t.remaining_s = rules.ticketRemainingS(now, t.expires_at)
    end
    return t
end

-- IDUNA's own JSON answer, checked against the bytes it signed. Two sources of truth for one ticket (the JSON
-- fields and the ticket's own payload) must AGREE -- if they do not, one of them is not the ticket IDUNA meant
-- to hand out, and the player should not be sent anywhere.
function M.from_mint(decoded, now_s)
    if type(decoded) ~= "table" then return { ok = false, reason = "no-answer" } end
    local t = M.usable(decoded.ticket, now_s)
    if not t.ok then return t end

    local pid = decoded.player_id
    if type(pid) ~= "string" or pid == "" then return { ok = false, reason = "no-player-id" } end
    if pid:lower() ~= t.player_id then return { ok = false, reason = "id-disagrees" } end

    local expires = tonumber(decoded.expires_at)
    if expires ~= nil and math.floor(expires) ~= t.expires_at then
        return { ok = false, reason = "expiry-disagrees" }
    end

    t.player_id = pid
    return t
end

return M
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX4">
      <Properties>
        <string name="Name">login460</string>
        <ProtectedString name="Source">-- src/login460.lua -- how a Roblox player gets a real IDUNA identity, with no password and no OAuth.
--
-- THE PROBLEM THIS SOLVES IS A REAL ONE, not a convenience. A Roblox place cannot run Google OAuth (no
-- browser tab, no redirect back) and should never ask for an IDUNA password. IDUNA's generic game
-- accounts are the answer: `POST /api/v1/games/{game}/guest-register` creates a REAL players row (a UUID),
-- issues an ES256 player token and hands back a `guest_secret` for signing back in. That is the same
-- account system DEADWEIGHT's own client uses; SHANKPIT now has a registry row (`shankpit`) for it.
--
-- The token this returns is what /api/v1/shankpit/ticket accepts: a game player token's subject is
-- "guest:&lt;uuid&gt;" and its identity is the `player_id` claim, which that handler now reads (it only read
-- `sub` before, so this whole path used to 400 -- found while wiring this file).
--
-- WHAT A GUEST ACCOUNT IS, stated once: no email, no recovery, the secret IS the account. The founder's
-- own convention for DEADWEIGHT ("no email, no recovery"), and the reason `guest_secret` is treated as a
-- credential here: it is stored, never shown, and never sent to a client.
--
-- Every function takes its `http` and its clock, so the whole thing is testable without Roblox:
--   http(method, url, body, headers) -&gt; decoded_table | nil, reason
-- which is exactly the shape lobby.server.lua's HttpService wrapper already has.

local M = {}

-- A token inside this margin is treated as needing a re-login: the ticket mint and the world connect
-- both take time, and a token that expires mid-handshake reads to a player as a lobby bug.
M.REFRESH_MARGIN_S = 300

function M.routes(base)
    return {
        register   = base .. "/guest-register",
        login      = base .. "/guest-login",
        set_name   = base .. "/set-display-name",
        -- Linking an email onto the SAME player row (guest-upgrade), and signing in with it later
        -- (email-login). IDUNA keeps one player_id across both, so seats and history carry over.
        upgrade    = base .. "/guest-upgrade",
        email_in   = base .. "/email-login",
    }
end

local function struggles(v) return type(v) ~= "string" or v == "" end

-- IDUNA's answer, checked rather than trusted: an identity is only real if it carries a player id, a
-- token, and an expiry. `guest_secret` is optional because guest-login's answer does not repeat it.
function M.from_answer(decoded, now_s)
    if type(decoded) ~= "table" then return nil, "no-answer" end
    if struggles(decoded.player_id) then return nil, "no-player-id" end
    if struggles(decoded.token) then return nil, "no-token" end
    local expires = tonumber(decoded.expires_at)
    if not expires then return nil, "no-expiry" end
    local now = tonumber(now_s)
    if now and expires &lt;= now then return nil, "expired" end
    return {
        player_id    = decoded.player_id,
        display_name = tostring(decoded.display_name or ""),
        token        = decoded.token,
        expires_at   = math.floor(expires),
        guest_secret = struggles(decoded.guest_secret) and nil or decoded.guest_secret,
        account_state = tostring(decoded.account_state or "guest"),
    }
end

-- Registering is the first-visit path: no name is required (IDUNA picks a lore-friendly one), and the
-- display name is only passed when the place has one worth keeping.
function M.sign_in(http, base, name, now_s)
    if type(http) ~= "function" then return nil, "no-http" end
    local body = "{}"
    if type(name) == "string" and name ~= "" then
        body = string.format('{"display_name":"%s"}', name:gsub('[\\"]', ""))
    end
    local decoded, reason = http("POST", M.routes(base).register, body,
        { ["Content-Type"] = "application/json" })
    if not decoded then return nil, reason or "no-answer" end
    return M.from_answer(decoded, now_s)
end

-- Signing back in is the returning path, and only the stored secret can do it -- the player id alone is
-- public. A `saved` table is whatever was persisted for this player (player_id + guest_secret).
function M.sign_back_in(http, base, saved, now_s)
    if type(saved) ~= "table" or struggles(saved.player_id) or struggles(saved.guest_secret) then
        return nil, "not-saved"
    end
    local decoded, reason = http("POST", M.routes(base).login,
        string.format('{"player_id":"%s","guest_secret":"%s"}', saved.player_id, saved.guest_secret),
        { ["Content-Type"] = "application/json" })
    if not decoded then return nil, reason or "no-answer" end
    local identity, why = M.from_answer(decoded, now_s)
    if not identity then return nil, why end
    -- guest-login does not repeat the secret; keep the one that worked so the next session can too.
    identity.guest_secret = identity.guest_secret or saved.guest_secret
    return identity
end

-- True while the token is worth using. A missing expiry is NOT fresh (an undated token is not evidence).
function M.token_ok(identity, now_s)
    if type(identity) ~= "table" or struggles(identity.token) then return false end
    local expires, now = tonumber(identity.expires_at), tonumber(now_s)
    if not expires or not now then return false end
    return expires - now &gt; M.REFRESH_MARGIN_S
end

-- Sign in for a Roblox UserId, reusing what was saved for them if it still works. Returns
-- identity, reason, and never mutates `store` -- the caller decides what to persist, because persisting
-- is the part that needs a running place (DataStore).
function M.identity_for(http, base, store, user_id, now_s)
    local saved = type(store) == "table" and store[user_id] or nil
    if saved and M.token_ok(saved, now_s) then return saved, nil, true end
    if saved and not struggles(saved.guest_secret) then
        local identity, why = M.sign_back_in(http, base, saved, now_s)
        if identity then return identity, nil, true end
        -- A saved secret that no longer works is a real answer ("401"), not a reason to silently mint a
        -- second account for the same person: fall through and register only if the caller allows it.
        return nil, why, false
    end
    return nil, "not-saved", false
end

-- Linking an email is what turns a throwaway guest into an account that survives: IDUNA's guest-upgrade
-- adds credentials to the SAME player row (same player_id, same history) and answers with a fresh player
-- token. The password is never stored here or by the place -- it is sent once because IDUNA needs it.
function M.link_email(http, base, identity, email, password, now_s)
    if type(identity) ~= "table" or struggles(identity.token) then return nil, "not-signed-in" end
    if struggles(email) or struggles(password) then return nil, "email-and-password-required" end
    local decoded, reason = http("POST", M.routes(base).upgrade,
        string.format('{"email":"%s","password":"%s"}', email:gsub('[\"]', ""), password:gsub('[\"]', "")),
        { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. identity.token })
    if not decoded then return nil, reason or "no-answer" end
    local linked, why = M.from_answer(decoded, now_s)
    if not linked then return nil, why end
    -- guest-upgrade does not repeat the guest secret; keep the one this identity already had so the
    -- account can still be opened the old way if the email is ever lost.
    linked.guest_secret = linked.guest_secret or identity.guest_secret
    linked.email = email
    return linked
end

-- Signing in with a linked email, from ANY place: this is what makes the account per-person rather than
-- per-place. Same token shape as guest-login (subject "email:&lt;uuid&gt;"), so the ticket mint accepts it.
function M.email_sign_in(http, base, email, password, now_s)
    if struggles(email) or struggles(password) then return nil, "email-and-password-required" end
    local decoded, reason = http("POST", M.routes(base).email_in,
        string.format('{"email":"%s","password":"%s"}', email:gsub('[\"]', ""), password:gsub('[\"]', "")),
        { ["Content-Type"] = "application/json" })
    if not decoded then return nil, reason or "no-answer" end
    local identity, why = M.from_answer(decoded, now_s)
    if not identity then return nil, why end
    identity.email = email
    return identity
end

-- What may be persisted for a player. The token is deliberately NOT in it: a token lives 24 h and is
-- cheaper to re-earn from the secret than to store in a place many people can read. The password is
-- never in it either -- the email is recorded so a screen can say what the account is linked to.
function M.to_save(identity)
    if type(identity) ~= "table" or struggles(identity.player_id) then return nil end
    return { player_id = identity.player_id, guest_secret = identity.guest_secret,
             display_name = identity.display_name, email = identity.email }
end

return M
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX5">
      <Properties>
        <string name="Name">queue460_rules</string>
        <ProtectedString name="Source">-- Generated by parena build (Lua target) -- do not edit by hand.
-- Source of truth: the .prn this was emitted from. SHANKPIT compiles the SAME file to C.

local M = {}

-- `a / b` in PARENA is C's integer division (truncation toward zero), not Lua's `//`
-- (floor). They disagree on every negative dividend, so the emitter routes `/` here
-- instead of pretending the two are the same operator.
local function __idiv(a, b)
    local q = a // b
    if q &lt; 0 and q * b ~= a then q = q + 1 end
    return q
end

function M.queueWindow(waitMs)
    return (function() local v = (100 + (__idiv((function() if (waitMs &lt; 0) then return 0 else return waitMs end end)(), 1000) * 50)); return (function() if (v &gt; 600) then return 600 else return v end end)() end)()
end

function M.queueStrictWindow(waitA, waitB)
    return (function() if (M.queueWindow(waitA) &lt; M.queueWindow(waitB)) then return M.queueWindow(waitA) else return M.queueWindow(waitB) end end)()
end

function M.queueGapFits(gap, waitA, waitB)
    return (function() local g = (function() if (gap &lt; 0) then return (0 - gap) else return gap end end)(); return (function() if (g &lt;= M.queueStrictWindow(waitA, waitB)) then return 1 else return 0 end end)() end)()
end

function M.queueExpired(waitMs)
    return (function() if (waitMs &gt; 120000) then return 1 else return 0 end end)()
end

function M.queueFillable(ranked, waitMs)
    return (function() if (ranked == 1) then return 0 else return (function() if (waitMs &gt;= 30000) then return 1 else return 0 end end)() end end)()
end

return M
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX6">
      <Properties>
        <string name="Name">ticket460_rules</string>
        <ProtectedString name="Source">-- Generated by parena build (Lua target) -- do not edit by hand.
-- Source of truth: the .prn this was emitted from. SHANKPIT compiles the SAME file to C.

local M = {}

-- `a / b` in PARENA is C's integer division (truncation toward zero), not Lua's `//`
-- (floor). They disagree on every negative dividend, so the emitter routes `/` here
-- instead of pretending the two are the same operator.
local function __idiv(a, b)
    local q = a // b
    if q &lt; 0 and q * b ~= a then q = q + 1 end
    return q
end

function M.ticketShapeOk(hexLen)
    return (function() if (hexLen == 72) then return 1 else return 0 end end)()
end

function M.ticketExpired(nowS, expiresS)
    return (function() if (nowS &gt;= expiresS) then return 1 else return 0 end end)()
end

function M.ticketRemainingS(nowS, expiresS)
    return (function() local d = (expiresS - nowS); return (function() if (d &lt; 0) then return 0 else return d end end)() end)()
end

return M
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX7">
      <Properties>
        <string name="Name">lobby</string>
        <ProtectedString name="Source">-- src/lobby.server.lua -- the glue: tickets minted by IDUNA, seats taken here, pairs read by the world.
--
-- Everything a test can reach is in the modules beside this file. What is here needs a running server: Players,
-- HttpService, RemoteEvents, a loop.
--
-- The 460 flow, end to end:
--   1. a body signs in: IDUNA's generic game account (guest-register) makes a REAL player row and token --
--      no password, no OAuth inside the engine. login460 does the reading and the validation; a secret is
--      persisted per Roblox UserId so the next session is the same account (guest-login), not a new one.
--   2. the server asks IDUNA for a connect ticket with that token as a Bearer, and reads IDUNA's answer through
--      ticket460.from_mint -- which refuses a ticket whose JSON fields disagree with the bytes IDUNA signed
--   3. the body takes a seat in casual or ranked (queue460), keyed by Roblox UserId
--   4. a tick pairs bodies by the widening window; each side is handed ITS OWN ticket to present to the C server
--   5. the published ladder is re-read and pushed to the screens (net460)
--
-- HONEST LIMITS, named where they bite:
--   * Roblox cannot reach 127.0.0.1 -- NetUrl/TicketUrl must be public endpoints.
--   * The login is an IDUNA GUEST account: real player_id, real ES256 token, no email and no recovery -- the
--     secret is the account. A player who wants to keep it across places needs IDUNA's own link-email flow,
--     which is a WOTAN page today and not wired to this lobby.
--   * Identity persistence uses DataStore keyed by Roblox UserId (player_id + guest_secret, never the token).
--     It is best-effort and pcall-guarded: a place with DataStore disabled still works, and simply forgets.
--   * There is NO binding yet between a Roblox UserId and a SHANKPIT pid, so a player queues at the default
--     rating (1000) and the board is read-only. Inventing a binding would put a made-up number on a screen.
--   * The arena is the C server. A pairing hands out a ticket; it does not host an FPS.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local queue460 = require(script.Parent.queue460)
local ticket460 = require(script.Parent.ticket460)
local net460 = require(script.Parent.net460)
local login460 = require(script.Parent.login460)
local stats460 = require(script.Parent.stats460)
local arena460 = require(script.Parent.arena460)

-- The three hosts used to be three hardcoded strings. They are now one switch: set the attributes
-- `IdunaBase` / `WotanBase` on this Script (e.g. `https://&lt;space&gt;.hf.space/api/v1` for a dev backend) and the
-- place points somewhere else without editing code. Empty/unset = exactly the production hosts it had before.
local function baseAttr(name, default)
    local v = script:GetAttribute(name)
    if type(v) == "string" and v ~= "" then return v end
    return default
end

local IDUNA_BASE = baseAttr("IdunaBase", "https://iam.okemily.com/api/v1")
local WOTAN_BASE = baseAttr("WotanBase", "https://okemily.com/api/v1")

local CONFIG = {
    NetUrl = WOTAN_BASE .. "/shankpit-net/deadweight",
    -- IDUNA's connect-ticket mint (IDUNA/internal/http/handlers/shankpit_ticket.go): 72 hex chars, 5 min TTL,
    -- presented once at PACKET_CONNECT and verified by the C server's own shared secret.
    TicketUrl = IDUNA_BASE .. "/shankpit/ticket",
    -- IDUNA's generic game accounts, scoped to the game the ticket endpoint is scoped to ("shankpit").
    -- A game player token's subject is "guest:&lt;uuid&gt;"; its player_id claim is what the ticket reads.
    GameUrl = IDUNA_BASE .. "/games/shankpit",
    BoardEvery = 5,
    QueueEvery = 1,
}

-- THE ARENA IS THE PLACE'S OWN LASER TAG CONTENT: Tools named Blaster/AutoBlaster, the Teams service and the
-- SpawnLocations the checked-in base place already ships. Nothing here creates, renames or clones any of it --
-- it reads what is there and says plainly when it is not, so a round either has an arena or has a reason. This
-- closes the gap with SHANKPIT-460: a round you can actually play, not only a ticket to one.
-- A Tool inside a player's Backpack is not the place's loadout: it is what somebody is carrying, and it sits
-- under Workspace the moment they equip it. Counting it would let one player's inventory become the arena.
local function insidePlayer(inst)
    local p = inst.Parent
    while p ~= nil do
        if p.ClassName == "Player" then return true end
        p = p.Parent
    end
    return false
end

local function collectArena()
    local tree = { teams = {}, spawns = {}, tools = {} }
    for _, serviceName in ipairs({ "Workspace", "ServerStorage", "StarterPack" }) do
        local okService, service = pcall(function() return game:GetService(serviceName) end)
        if okService then
            local okDesc, descendants = pcall(function() return service:GetDescendants() end)
            if okDesc then
                for _, inst in ipairs(descendants) do
                    if inst.ClassName == "SpawnLocation" then
                        tree.spawns[#tree.spawns + 1] = {
                            name = inst.Name,
                            team = (inst.Team ~= nil) and inst.Team.Name or nil,
                        }
                    elseif inst.ClassName == "Tool" and not insidePlayer(inst) then
                        tree.tools[#tree.tools + 1] = { name = inst.Name }
                    end
                end
            end
        end
    end
    local okTeams, teamsService = pcall(function() return game:GetService("Teams") end)
    if okTeams then
        local okList, list = pcall(function() return teamsService:GetTeams() end)
        if okList then
            for _, team in ipairs(list) do tree.teams[#tree.teams + 1] = { name = team.Name } end
        end
    end
    return tree
end

local ARENA = arena460.describe(collectArena())
if not ARENA.ok then
    warn("arena460: this place has no usable arena -- " .. table.concat(ARENA.missing, ",") ..
         " (players can still queue; a round will say why it cannot start)")
end

-- The arena is not read once and frozen: a Studio session adds its pads after this script starts, and a publish
-- can take a team away. Only pads, tools and teams matter, and the loop re-reads at most every two seconds, so a
-- place full of effects does not turn GetDescendants into a per-frame job. `arena460.refresh` keeps the last
-- usable arena when a re-read comes back worse; this only decides WHEN to look again.
local ARENA_MIN_REREAD_MS = 2000
local arenaDirty, arenaStale = false, (ARENA.stale == true)
local function arenaRelevant(inst)
    return inst.ClassName == "SpawnLocation" or inst.ClassName == "Tool"
end
for _, serviceName in ipairs({ "Workspace", "ServerStorage", "StarterPack" }) do
    pcall(function()
        local service = game:GetService(serviceName)
        service.DescendantAdded:Connect(function(inst)
            if arenaRelevant(inst) then arenaDirty = true end
        end)
        service.DescendantRemoved:Connect(function(inst)
            if arenaRelevant(inst) then arenaDirty = true end
        end)
    end)
end
pcall(function()
    local teamsService = game:GetService("Teams")
    teamsService.TeamAdded:Connect(function() arenaDirty = true end)
    teamsService.TeamRemoved:Connect(function() arenaDirty = true end)
end)

local queue = queue460.new()
local snapshot = nil
local seats = {}          -- [player] = { user_id, uuid, name, mode, ticket, expires_at, queued_at }
local identities = {}     -- [player] = login460 identity (player_id, token, expires_at, guest_secret)
local savedFor = {}       -- [user_id] = what may be persisted (player_id + guest_secret, never the token)

-- Identity persistence. DataStore is optional on purpose: a place that cannot reach it still runs, and the
-- ONLY thing lost is that a returning player is a new guest instead of the same one.
local storeOk, identityStore = pcall(function()
    return game:GetService("DataStoreService"):GetDataStore("SHANKPIT460_Identity_v1")
end)
if not storeOk then identityStore = nil end

-- WOTAN and IDUNA are the truth; this is the place's cache of what they publish (src/stats460.lua). The board
-- is still pushed whole to the screens; the fan-out is for anything that needs a per-record write.
local statsCache = stats460.new()
local statsSinks = {}
do
    local haveStore, statsStore = pcall(function()
        return game:GetService("DataStoreService"):GetDataStore("SHANKPIT460_Stats_v1")
    end)
    if haveStore then
        statsSinks[#statsSinks + 1] = {
            name = "datastore",
            write = function(record) statsStore:SetAsync("p" .. tostring(record.pid), record) end,
        }
    end
end

local function loadSaved(userId)
    if not identityStore then return nil end
    local ok, saved = pcall(function() return identityStore:GetAsync("u" .. tostring(userId)) end)
    if not ok or type(saved) ~= "table" then return nil end
    return saved
end

local function saveIdentity(userId, identity)
    local saved = login460.to_save(identity)
    if not saved or not identityStore then return end
    savedFor[userId] = saved
    pcall(function() identityStore:SetAsync("u" .. tostring(userId), saved) end)
end

local function event(name)
    local e = Instance.new("RemoteEvent")
    e.Name = name
    e.Parent = ReplicatedStorage
    return e
end

local matchFound = event("SHANKPIT460_MatchFound")
local boardEvent = event("SHANKPIT460_Board")
local queueEvent = event("SHANKPIT460_Queue")

local function nowMs()
    return math.floor(os.clock() * 1000)
end

local function httpJson(url, method, body, headers)
    if url == "" then return nil, "not-configured" end
    local ok, res = pcall(function()
        return HttpService:RequestAsync({
            Url = url,
            Method = method or "GET",
            Headers = headers or { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
    if not ok then return nil, "http-failed" end
    if not res.Success then return nil, "http-" .. tostring(res.StatusCode) end
    local decoded
    local decodedOk = pcall(function()
        decoded = HttpService:JSONDecode(res.Body)
    end)
    if not decodedOk then return nil, "bad-json" end
    return decoded, nil
end

-- Step 2. IDUNA mints; this server only reads what came back, and only through the module that knows the bytes.
local function mintTicket(token)
    if type(token) ~= "string" or token == "" then return { ok = false, reason = "no-token" } end
    local decoded, err = httpJson(CONFIG.TicketUrl, "POST", "{}", {
        ["Authorization"] = "Bearer " .. token,
        ["Content-Type"] = "application/json",
    })
    if not decoded then return { ok = false, reason = err or "no-answer" } end
    return ticket460.from_mint(decoded, os.time())
end

local function pushBoard()
    if not snapshot then return end
    boardEvent:FireAllClients({
        rows = net460.rows(snapshot, 10),
        population = net460.population(snapshot),
        supports = net460.supports(snapshot),
        stale = net460.stale(snapshot, nowMs()),
    })
end

local function refreshSnapshot()
    local decoded, err = httpJson(CONFIG.NetUrl, "GET", nil)
    if type(decoded) == "table" then
        snapshot = decoded
        local records = type(decoded.records) == "table" and decoded.records or {}
        -- `recent[]` is the per-match ticker (pid0/pid1/winner/ms). `results[]` is an aggregate per challenge
        -- kind and cannot drive a per-player update, so it is deliberately not read here.
        local recent = type(decoded.recent) == "table" and decoded.recent or {}
        if not statsCache.booted then
            -- Cold start: load the ladder, REMEMBER the ticker, replay nothing. Those matches already happened.
            stats460.boot(statsCache, records, recent)
        else
            local applied = 0
            for _, match in ipairs(recent) do
                if stats460.apply_result(statsCache, match, nowMs()) then applied = applied + 1 end
            end
            local reconciled = stats460.reconcile(statsCache, records, nowMs())
            local pids = {}
            for _, record in ipairs(records) do
                if record.pid ~= nil then pids[#pids + 1] = stats460.key(record.pid) end
            end
            local fanned = stats460.fan_out(statsCache, pids, statsSinks)
            if applied &gt; 0 or reconciled.conflicts &gt; 0 or reconciled.expired &gt; 0 or #fanned.failed &gt; 0 then
                print(string.format(
                    "stats460: %d results, %d confirmed, %d conflicts, %d expired; fan-out %d ok, %d failed",
                    applied, reconciled.confirmed, reconciled.conflicts, reconciled.expired,
                    fanned.ok, #fanned.failed))
            end
        end
    elseif err then
        -- a dead authority leaves the cache exactly as it was: stale is readable, invented is not
        print("stats460: board read failed (" .. tostring(err) .. ") -- keeping the last cache")
    end
    pushBoard()
end

-- Step 1. Sign in for real. Reuse what was saved for this UserId, otherwise register a real IDUNA player.
local function ensureIdentity(player)
    local existing = identities[player]
    if existing and login460.token_ok(existing, os.time()) then return existing, nil end

    local saved = savedFor[player.UserId] or loadSaved(player.UserId)
    if saved then
        local identity, why, wasSaved = login460.identity_for(
            function(method, url, body, headers) return httpJson(url, method, body, headers) end,
            CONFIG.GameUrl, { [player.UserId] = saved }, player.UserId, os.time())
        if identity then
            identities[player] = identity
            saveIdentity(player.UserId, identity)
            return identity, nil
        end
        -- A saved secret IDUNA no longer accepts is a real refusal; registering a second account behind the
        -- player's back would silently split their history, so it is reported instead.
        if wasSaved or why == "http-401" or why == "http-403" then return nil, "signin:" .. tostring(why) end
    end

    local identity, why = login460.sign_in(
        function(method, url, body, headers) return httpJson(url, method, body, headers) end,
        CONFIG.GameUrl, player.DisplayName, os.time())
    if not identity then return nil, "signup:" .. tostring(why) end
    identities[player] = identity
    saveIdentity(player.UserId, identity)
    return identity, nil
end

local function dropSeat(player)
    local seat = seats[player]
    if not seat then return end
    queue460.remove(queue, seat.mode, seat.user_id)
    seats[player] = nil
end

Players.PlayerAdded:Connect(function(player)
    player:SetAttribute("SHANKPIT460_State", "needs-ticket")
    player:SetAttribute("SHANKPIT460_Pid", "")
end)

queueEvent.OnServerEvent:Connect(function(player, action, arg)
    if action == "signin" then
        local identity, why = ensureIdentity(player)
        if not identity then
            player:SetAttribute("SHANKPIT460_State", "refused:" .. tostring(why))
            return
        end
        player:SetAttribute("SHANKPIT460_Pid", identity.player_id)
        player:SetAttribute("SHANKPIT460_State", "signed-in")
        queueEvent:FireClient(player, {
            signed_in = true,
            player_id = identity.player_id,
            display_name = identity.display_name,
            account_state = identity.account_state,
            email = identity.email,
        })
    elseif action == "link" then
        -- "Keep this account": IDUNA adds credentials to the SAME player row, so history carries over.
        -- The password is forwarded once and never stored by this server or this place.
        local identity = identities[player]
        if not identity then identity, _ = ensureIdentity(player) end
        if not identity then
            player:SetAttribute("SHANKPIT460_State", "refused:not-signed-in")
            return
        end
        local linked, why = login460.link_email(
            function(method, url, body, headers) return httpJson(url, method, body, headers) end,
            CONFIG.GameUrl, identity,
            tostring(arg and arg.email or ""), tostring(arg and arg.password or ""), os.time())
        if not linked then
            player:SetAttribute("SHANKPIT460_State", "refused:link:" .. tostring(why))
            queueEvent:FireClient(player, { link_error = tostring(why) })
            return
        end
        identities[player] = linked
        saveIdentity(player.UserId, linked)
        player:SetAttribute("SHANKPIT460_State", "linked")
        queueEvent:FireClient(player, { linked = true, email = linked.email })
    elseif action == "join" then
        local mode = tostring(arg and arg.mode or "casual")
        -- A hand-passed token still works (a player who signed in on IDUNA's own page), otherwise this
        -- server signs the player in itself.
        local identity = identities[player]
        if type(arg) == "table" and type(arg.token) == "string" and arg.token ~= "" then
            identity = nil
        else
            identity, _ = ensureIdentity(player)
        end
        if not identity and not (type(arg) == "table" and arg.token) then
            player:SetAttribute("SHANKPIT460_State", "refused:not-signed-in")
            return
        end
        local verdict = mintTicket(type(arg) == "table" and arg.token or identity.token)
        if not verdict.ok then
            player:SetAttribute("SHANKPIT460_State", "refused:" .. tostring(verdict.reason))
            return
        end
        -- The ticket is for whoever IDUNA says the token belongs to; a mismatch means the token and the
        -- seat disagree and the player is not sent anywhere.
        if identity and verdict.player_id ~= identity.player_id then
            player:SetAttribute("SHANKPIT460_State", "refused:signed-in-as-someone-else")
            return
        end
        local rating = nil
        -- A rating needs the world's ladder row for this identity, and the ladder is keyed by the world's
        -- own pid -- a binding that does not exist yet. The queue's default (1000, the ladder's own
        -- rating_start) stands in rather than a made-up number.
        local entry, why = queue460.enqueue(queue, mode, {
            pid = player.UserId,
            rating = rating,
            name = (identity and identity.display_name ~= "" and identity.display_name) or player.Name,
            joined_ms = nowMs(),
        })
        if not entry then
            player:SetAttribute("SHANKPIT460_State", "queue:" .. tostring(why))
            return
        end
        seats[player] = {
            user_id = player.UserId,
            uuid = verdict.player_id,
            name = (identity and identity.display_name ~= "" and identity.display_name) or player.Name,
            mode = mode,
            ticket = verdict.hex,
            expires_at = verdict.expires_at,
            queued_at = entry.joined_ms,
        }
        player:SetAttribute("SHANKPIT460_State", "queued:" .. mode)
        player:SetAttribute("SHANKPIT460_Pid", verdict.player_id)
        queueEvent:FireClient(player, {
            position = queue460.position(queue, mode, player.UserId),
            mode = mode,
            rating = entry.rating,
            expires_at = verdict.expires_at,
        })
    elseif action == "leave" then
        dropSeat(player)
        player:SetAttribute("SHANKPIT460_State", "needs-ticket")
    end
end)

Players.PlayerRemoving:Connect(dropSeat)

-- One loop: the queue every second, the board every five. A client can neither seat itself nor declare a result.
task.spawn(function()
    local lastQueue, lastBoard, lastArena = 0, 0, 0
    while true do
        local now = nowMs()
        if arenaDirty and now - lastArena &gt;= ARENA_MIN_REREAD_MS then
            lastArena = now
            arenaDirty = false
            ARENA = arena460.refresh(ARENA, collectArena())
            if (ARENA.stale == true) ~= arenaStale then
                arenaStale = (ARENA.stale == true)
                if arenaStale then
                    warn("arena460: this place no longer reads as a usable arena (" ..
                         table.concat(ARENA.fresh_missing or {}, ",") ..
                         ") -- rounds keep the last arena it did")
                else
                    print(string.format("arena460: arena re-read -- %d pads, %d weapons, %d teams",
                        #ARENA.spawns, #ARENA.weapons, #ARENA.teams))
                end
            end
        end
        if now - lastQueue &gt;= CONFIG.QueueEvery * 1000 then
            lastQueue = now
            local nowS = os.time()
            for _, mode in ipairs({ "casual", "ranked" }) do
                local tick = queue460.tick(queue, mode, now)
                for _, p in ipairs(tick.pairs) do
                    for player, seat in pairs(seats) do
                        if seat.user_id == p.first.pid or seat.user_id == p.second.pid then
                            local iAmFirst = (seat.user_id == p.first.pid)
                            -- A ticket has a 5-minute life and was minted when they queued, so tell each side
                            -- what is actually left rather than what it was at mint time.
                            local remaining = ticket460.usable(seat.ticket, nowS)
                            matchFound:FireClient(player, {
                                mode = mode,
                                uuid = seat.uuid,
                                opponent = iAmFirst and p.second.name or p.first.name,
                                opponent_rating = iAmFirst and p.second.rating or p.first.rating,
                                gap = p.gap,
                                ticket = seat.ticket,
                                expires_at = seat.expires_at,
                                ticket_ok = remaining.ok,
                                ticket_reason = remaining.ok and nil or remaining.reason,
                                -- What the round needs from the place itself, read once from its own Laser Tag
                                -- content. nil + a reason when the place cannot host one; never a default.
                                arena_ok = ARENA.ok,
                                arena_spawn = ARENA.ok and ARENA.spawns[1].name or nil,
                                arena_weapon = ARENA.ok and ARENA.weapons[1] or nil,
                                arena_teams = ARENA.ok and ARENA.teams or nil,
                                arena_reason = ARENA.ok and nil or table.concat(ARENA.missing, ","),
                            })
                            player:SetAttribute("SHANKPIT460_State", "matched:" .. mode)
                            seats[player] = nil
                        end
                    end
                end
                for _, e in ipairs(tick.expired) do
                    for player, seat in pairs(seats) do
                        if seat.user_id == e.pid then
                            player:SetAttribute("SHANKPIT460_State", "expired")
                            seats[player] = nil
                        end
                    end
                end
                for _, e in ipairs(tick.fills) do
                    -- casual only; the body STAYS queued, because a human who arrives first still wins.
                    queueEvent:FireAllClients({ fillable = { pid = e.pid, name = e.name, mode = mode } })
                end
            end
        end
        if now - lastBoard &gt;= CONFIG.BoardEvery * 1000 then
            lastBoard = now
            refreshSnapshot()
        end
        task.wait(0.25)
    end
end)

refreshSnapshot()
</ProtectedString>
        <bool name="Disabled">true</bool>
      </Properties>
