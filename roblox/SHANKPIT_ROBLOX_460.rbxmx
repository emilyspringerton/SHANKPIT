    <Item class="LocalScript" referent="RBX8">
      <Properties>
        <string name="Name">lobby_client</string>
        <ProtectedString name="Source">-- src/lobby.client.lua -- what a body actually sees: the queue, the board, and a match to join.
--
-- LocalScript. In Studio it belongs in STARTERPLAYERSCRIPTS (not beside the server Script), and the README says
-- so, because putting it in the same folder is the mistake that makes a lobby look finished with nothing on
-- screen.
--
-- It draws and it asks. It never decides: no seat, no result and no board row is computed here. Every number on
-- this screen arrived from the server, which got it from the world (`SHANKPIT460_Board`) or from the queue
-- (`SHANKPIT460_Queue`).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local queueEvent = ReplicatedStorage:WaitForChild("SHANKPIT460_Queue")
local boardEvent = ReplicatedStorage:WaitForChild("SHANKPIT460_Board")
local matchEvent = ReplicatedStorage:WaitForChild("SHANKPIT460_MatchFound")

local gui = Instance.new("ScreenGui")
gui.Name = "SHANKPIT460"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Size = UDim2.new(0, 320, 0, 470)
panel.Position = UDim2.new(0, 16, 0, 16)
panel.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
panel.BorderSizePixel = 0
panel.Parent = gui

local function label(text, y, height, size, color)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -16, 0, height)
    l.Position = UDim2.new(0, 8, 0, y)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.Code
    l.TextSize = size or 14
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextColor3 = color or Color3.fromRGB(232, 232, 232)
    l.Text = text
    l.Parent = panel
    return l
end

local function button(text, y, x, width)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, width, 0, 26)
    b.Position = UDim2.new(0, x, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
    b.BorderSizePixel = 0
    b.Font = Enum.Font.Code
    b.TextSize = 13
    b.TextColor3 = Color3.fromRGB(240, 240, 240)
    b.Text = text
    b.Parent = panel
    return b
end

local title = label("SHANKPIT // 460", 8, 20, 16)
title.TextColor3 = Color3.fromRGB(120, 220, 190)

local state = label("state: connecting", 32, 18, 12, Color3.fromRGB(160, 160, 160))
local boardHead = label("LADDER", 58, 16, 12, Color3.fromRGB(160, 160, 160))
local board = Instance.new("TextLabel")
board.Size = UDim2.new(1, -16, 0, 132)
board.Position = UDim2.new(0, 8, 0, 76)
board.BackgroundTransparency = 1
board.Font = Enum.Font.Code
board.TextSize = 12
board.TextXAlignment = Enum.TextXAlignment.Left
board.TextYAlignment = Enum.TextYAlignment.Top
board.TextColor3 = Color3.fromRGB(220, 220, 220)
board.Text = ""
board.Parent = panel

local selfLine = label("you: not queued", 214, 18, 12, Color3.fromRGB(200, 200, 140))
local casual = button("CASUAL", 236, 8, 96)
local ranked = button("RANKED", 236, 112, 96)
local signin = button("SIGN IN", 236, 216, 96)
local leave = button("LEAVE QUEUE", 266, 8, 300)

-- Keeping the account: a guest is throwaway (no email, no recovery). Linking one turns it into an
-- account that can be signed into from any place, and keeps the same player id.
local function field(placeholder, y)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -16, 0, 24)
    box.Position = UDim2.new(0, 8, 0, y)
    box.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
    box.BorderSizePixel = 0
    box.Font = Enum.Font.Code
    box.TextSize = 12
    box.TextColor3 = Color3.fromRGB(235, 235, 235)
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
    box.Text = ""
    box.ClearTextOnFocus = false
    box.Parent = panel
    return box
end

local emailBox = field("email (to keep this account)", 296)
local passBox = field("password, 8+ characters", 324)
local link = button("LINK EMAIL", 352, 8, 300)

local matchFrame = Instance.new("Frame")
matchFrame.Size = UDim2.new(1, -16, 0, 64)
matchFrame.Position = UDim2.new(0, 8, 0, 384)
matchFrame.BackgroundColor3 = Color3.fromRGB(28, 46, 40)
matchFrame.BorderSizePixel = 0
matchFrame.Visible = false
matchFrame.Parent = panel

local matchText = Instance.new("TextLabel")
matchText.Size = UDim2.new(1, -12, 1, -8)
matchText.Position = UDim2.new(0, 6, 0, 4)
matchText.BackgroundTransparency = 1
matchText.Font = Enum.Font.Code
matchText.TextSize = 12
matchText.TextXAlignment = Enum.TextXAlignment.Left
matchText.TextYAlignment = Enum.TextYAlignment.Top
matchText.TextColor3 = Color3.fromRGB(210, 245, 235)
matchText.Text = ""
matchText.Parent = matchFrame

-- The ticket is what the C server will verify, so it is shown rather than hidden: a player who cannot see it
-- cannot tell a lobby bug from a server one.
local match = nil
local matchExpiresAt = 0

-- A token may still be handed in by hand (_G) for testing; leaving it unset is the normal path, where the
-- SERVER signs the player in with IDUNA's guest account and never shows a secret to this client.
local function requestJoin(mode)
    queueEvent:FireServer("join", { mode = mode, token = _G.SHANKPIT460_IDUNA_TOKEN })
end

casual.MouseButton1Click:Connect(function() requestJoin("casual") end)
ranked.MouseButton1Click:Connect(function() requestJoin("ranked") end)
signin.MouseButton1Click:Connect(function()
    state.Text = "state: signing in with IDUNA"
    queueEvent:FireServer("signin")
end)
link.MouseButton1Click:Connect(function()
    state.Text = "state: linking email with IDUNA"
    -- The server forwards this once; it is not stored here and never comes back.
    queueEvent:FireServer("link", { email = emailBox.Text, password = passBox.Text })
end)
leave.MouseButton1Click:Connect(function()
    match = nil
    matchFrame.Visible = false
    queueEvent:FireServer("leave")
end)

local function renderBoard(payload)
    if type(payload) ~= "table" then return end
    local lines = {}
    local pop = payload.population or {}
    lines[#lines + 1] = string.format("%d bodies, meta %s%s", pop.count or 0, tostring(pop.meta_kind or "none"),
        payload.stale and "  (STALE)" or "")
    local rows = payload.rows or {}
    if #rows == 0 then
        lines[#lines + 1] = "no bodies yet"
    end
    for i = 1, math.min(#rows, 8) do
        local r = rows[i]
        local rating = r.rating and tostring(r.rating) or "?"
        lines[#lines + 1] = string.format("%d. %-12s %5s  %d/%d", r.standing, tostring(r.name), rating,
            r.wins, r.games)
    end
    if payload.supports and payload.supports.stage then
        lines[#lines + 1] = "stage: published"
    end
    board.Text = table.concat(lines, "\n")
end

boardEvent.OnClientEvent:Connect(renderBoard)

queueEvent.OnClientEvent:Connect(function(payload)
    if type(payload) ~= "table" then return end
    if payload.linked then
        state.Text = "state: linked to " .. tostring(payload.email)
        selfLine.Text = "iduna: kept (" .. tostring(payload.email) .. ")"
    elseif payload.link_error then
        state.Text = "state: link refused (" .. tostring(payload.link_error) .. ")"
    elseif payload.signed_in then
        state.Text = string.format("state: signed in as %s (%s)", tostring(payload.display_name),
            tostring(payload.account_state))
        selfLine.Text = "iduna: " .. tostring(payload.player_id):sub(1, 8)
    elseif payload.fillable then
        state.Text = string.format("state: a citizen may fill %s (still queued)", tostring(payload.fillable.mode))
    elseif payload.position then
        state.Text = string.format("state: queued %s at #%d (rating %s)", tostring(payload.mode),
            payload.position, tostring(payload.rating))
    end
end)

matchEvent.OnClientEvent:Connect(function(payload)
    if type(payload) ~= "table" then return end
    match = payload
    matchExpiresAt = tonumber(payload.expires_at) or 0
    matchFrame.Visible = true
end)

player:GetAttributeChangedSignal("SHANKPIT460_State"):Connect(function()
    state.Text = "state: " .. tostring(player:GetAttribute("SHANKPIT460_State"))
end)

task.spawn(function()
    while true do
        if match then
            local left = matchExpiresAt - os.time()
            if left &lt; 0 then left = 0 end
            local ticket = tostring(match.ticket or "")
            matchText.Text = string.format(
                "MATCH %s vs %s (gap %d)\nticket %s... %ds left\nopen SHANKPIT and paste the ticket",
                tostring(match.mode), tostring(match.opponent), tonumber(match.gap) or 0,
                string.sub(ticket, 1, 12), left)
            if left == 0 then
                matchFrame.BackgroundColor3 = Color3.fromRGB(58, 34, 34)
            end
        end
        task.wait(1)
    end
end)
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX9">
      <Properties>
        <string name="Name">arena460</string>
        <ProtectedString name="Source">-- src/arena460.lua -- the place's OWN Laser Tag content, read as the arena for a SHANKPIT 460 round.
--
-- WHY THIS EXISTS: SHANKPIT-460 is a client you play a round in. This layer used to stop at the front door --
-- sign in, queue, take a ticket -- and leave the player with nowhere to go. The checked-in base place
-- (`shankpit_roblox.rbxl`) already ships Roblox's Laser Tag content (Tools named `Blaster` / `AutoBlaster`,
-- a `Teams` service, `SpawnLocation`s including a green one, `Tagged`, `TeamColor`), so the arena is a thing to
-- READ, not a thing to build. Nothing here creates, renames or clones an instance: it takes a plain description
-- of the place and answers what a round needs, so the answers are testable without a Roblox runtime.
--
-- It owns no rule the place already owns: Roblox's own Tool damage and Teams decide tags. This module only says
-- which spawn belongs to which team, which weapon a seat gets, and who won from final tag counts it is handed.
-- It refuses to invent an arena: no spawns, no weapons, no teams, or a team with no spawn is reported as a
-- reason the round cannot start rather than papered over with a default.

local M = {}

local unpack = table.unpack or unpack

-- tree = {
--   teams  = { { name = "Red Team" }, ... },
--   spawns = { { name = "SpawnLocation", team = "Red Team" }, ... },   -- team may be nil
--   tools  = { { name = "Blaster" }, ... },
-- }
function M.describe(tree)
    local out = { ok = false, teams = {}, spawns = {}, weapons = {}, missing = {} }
    if type(tree) ~= "table" then
        out.missing[#out.missing + 1] = "no-place"
        return out
    end

    for _, team in ipairs(tree.teams or {}) do
        if type(team) == "table" and type(team.name) == "string" and team.name ~= "" then
            out.teams[#out.teams + 1] = team.name
        end
    end
    for _, spawn in ipairs(tree.spawns or {}) do
        if type(spawn) == "table" and type(spawn.name) == "string" and spawn.name ~= "" then
            out.spawns[#out.spawns + 1] = { name = spawn.name, team = spawn.team }
        end
    end
    for _, tool in ipairs(tree.tools or {}) do
        if type(tool) == "table" and type(tool.name) == "string" and tool.name ~= "" then
            out.weapons[#out.weapons + 1] = tool.name
        end
    end

    if #out.teams == 0 then out.missing[#out.missing + 1] = "no-teams" end
    if #out.spawns == 0 then out.missing[#out.missing + 1] = "no-spawns" end
    if #out.weapons == 0 then out.missing[#out.missing + 1] = "no-weapons" end

    -- A team with no pad is a seat with nowhere to stand. Report the team, do not fall back to someone else's.
    for _, team in ipairs(out.teams) do
        local covered = false
        for _, spawn in ipairs(out.spawns) do
            if spawn.team == team then covered = true end
        end
        if not covered then out.missing[#out.missing + 1] = "no-spawn-for-team:" .. team end
    end

    out.ok = #out.missing == 0
    return out
end

-- A place is not frozen: a Studio session adds the pads after the server script starts, and a publish can take
-- one away. So the arena is re-read -- but a re-read is allowed to be WORSE than what we had (Workspace is
-- briefly empty while a place rebuilds, a team edit lands before its pad does), and a lobby that forgot its
-- arena mid-session would refuse rounds it could actually host. A usable read replaces; an unusable read keeps
-- the last usable arena and reports what the re-read could not see, so the reason is still inspectable.
function M.refresh(previous, tree)
    local fresh = M.describe(tree)
    if fresh.ok then return fresh, nil end
    if type(previous) == "table" and previous.ok then
        return {
            ok = true, stale = true,
            teams = previous.teams, spawns = previous.spawns, weapons = previous.weapons,
            missing = {}, fresh_missing = fresh.missing,
        }, "kept-last-usable:" .. table.concat(fresh.missing, ",")
    end
    return fresh, nil
end

-- Seats in, assignments out. Teams alternate in seat order, deterministically, so two players never land on the
-- same side by accident of dictionary ordering. A SpawnLocation is re-usable (that is what it is for), so more
-- seats than pads is not a failure; no pad at all already failed in describe().
function M.seat(arena, seats)
    if type(arena) ~= "table" or not arena.ok then return nil, "arena-not-ok" end
    if type(seats) ~= "table" or #seats == 0 then return nil, "no-seats" end
    local out = {}
    for i, seat in ipairs(seats) do
        -- teams[i] is the team this seat is on; a pad is found by THAT name, never by seat parity alone
        local team = arena.teams[((i - 1) % #arena.teams) + 1]
        local spawn = nil
        for _, pad in ipairs(arena.spawns) do
            if spawn == nil and pad.team == team then spawn = pad.name end
        end
        out[#out + 1] = { seat = seat, team = team, spawn = spawn }
    end
    return out
end

-- The tools a seat is given. This layer does not decide what a Blaster does -- Roblox's own Tool does.
function M.loadout(arena)
    if type(arena) ~= "table" or not arena.ok then return nil, "arena-not-ok" end
    return { weapons = { unpack(arena.weapons) } }
end

-- Final tag counts in, a result out. A tie is a draw, not a coin flip; a malformed count is refused rather than
-- read as zero, because "nobody tagged anyone" and "the number is missing" are different facts.
function M.result(tags)
    if type(tags) ~= "table" or #tags == 0 then return nil, "no-tags" end
    local best, bestTags, tie = nil, -1, false
    for _, entry in ipairs(tags) do
        local name = type(entry) == "table" and entry.team or nil
        local count = type(entry) == "table" and tonumber(entry.tags) or nil
        if type(name) ~= "string" or name == "" or count == nil then return nil, "bad-tags" end
        if count &gt; bestTags then
            best, bestTags, tie = name, count, false
        elseif count == bestTags then
            tie = true
        end
    end
    if tie then return { draw = true, winner = nil, tags = tags } end
    return { draw = false, winner = best, tags = tags }
end

-- Which seats won. A draw wins nobody, and a seat whose team is not the winner is not "lost" by invention --
-- it is simply not the winner.
function M.outcomes(assignments, result)
    local out = {}
    if type(assignments) ~= "table" or type(result) ~= "table" then return out end
    for _, assignment in ipairs(assignments) do
        out[#out + 1] = {
            seat = assignment.seat,
            team = assignment.team,
            won = (not result.draw) and assignment.team == result.winner or false,
        }
    end
    return out
end

return M
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX10">
      <Properties>
        <string name="Name">stats460</string>
        <ProtectedString name="Source">-- src/stats460.lua -- the Roblox side of the stats as a CACHE that is allowed to run ahead of the truth.
--
-- The ordering this file assumes, stated once because everything else follows from it:
--
--     IDUNA and WOTAN are the authority.  The place is a cache of what they publish.
--
-- So the cache may write optimistically -- a match that the world has published is applied NOW, so the player
-- sees their win on this frame instead of waiting for the next board read -- but the cache never becomes the
-- record. `reconcile()` is the only thing that sets a value to authority truth, and `rollback()` exists because
-- an optimistic write the authority refuses must be undone rather than forgotten.
--
-- Two things this file refuses to do, both because a fabricated stat is worse than a blank one:
--   * invent a field: a delta may only move a numeric field the record ALREADY carries;
--   * invent a rating: `recent[]` says who won, not by how much Elo, so results move wins/games only and the
--     rating stays whatever the authority last published.
--
-- WHERE THE RESULTS COME FROM (checked against the publisher, not assumed): `packages/simulation/dw_net.c`
-- writes `results[]` as an aggregate per challenge kind ({kind, kind_id, matches}) and `recent[]` as the
-- per-match ticker ({kind, pid0, pid1, winner, rounds, hull0, hull1, ms}, newest first). Only `recent[]` can
-- drive a per-player update; `results[]` cannot and is not used for one.
--
-- Pids: the publisher emits pids as NUMBERS. Keys here are normalised through `M.key()` so a numeric pid, a
-- string pid and the same player in two shapes are one cache entry -- the place was dropped on this exact
-- distinction once already.
--
-- No HTTP, no DataStore, no game: callers pass records in and sinks out, which is what lets this be tested
-- under plain Lua (roblox/tests/stats460_test.lua).

local M = {}

-- How long an unacknowledged write may stand. Past this the authority has had several publication intervals
-- to answer and did not, so the write is treated as lost and the previous value is restored.
M.PENDING_TTL_MS = 30000

-- How many result keys are remembered for de-duplication. `recent[]` is capped and re-sent every poll, so the
-- window only has to outlast the ticker.
M.SEEN_MAX = 64

function M.key(pid)
    if pid == nil then return nil end
    return tostring(pid)
end

local function shallow(t)
    local o = {}
    for k, v in pairs(t) do o[k] = v end
    return o
end

local function find_pending(cache, key)
    for i, p in ipairs(cache.pending) do
        if p.pid == key then return p, i end
    end
    return nil, nil
end

local function remember(cache, key)
    cache.seen = cache.seen or {}
    cache.seen_order = cache.seen_order or {}
    if cache.seen[key] then return false end
    cache.seen[key] = true
    cache.seen_order[#cache.seen_order + 1] = key
    if #cache.seen_order &gt; M.SEEN_MAX then
        local dropped = table.remove(cache.seen_order, 1)
        cache.seen[dropped] = nil
    end
    return true
end

-- cache.records: key(pid) -&gt; record (the authority's shape, plus any optimistic edit on top)
-- cache.pending: writes the authority has not answered yet, at most one per player (deltas merge into it)
function M.new(opts)
    opts = opts or {}
    return {
        records = {},
        pending = {},
        seen = {},
        seen_order = {},
        booted = false,
        seq = 0,
        clock = opts.clock,
        log = opts.log,
    }
end

function M.get(cache, pid)
    local r = cache.records[M.key(pid)]
    return r and shallow(r) or nil
end

-- Load authority truth with no optimistic intent (first paint, or a record nobody has touched).
function M.put(cache, record)
    if type(record) ~= "table" then return nil, "no-record" end
    local key = M.key(record.pid)
    if not key or key == "" then return nil, "no-pid" end
    cache.records[key] = shallow(record)
    return shallow(record)
end

function M.is_pending(cache, pid)
    return (find_pending(cache, M.key(pid))) ~= nil
end

-- Apply a delta immediately. Only numeric fields the record already carries move; the skipped count is reported
-- so a caller can see that part of its delta had nowhere to land. A second write while one is pending MERGES
-- into it (keeping the original `before`), because two matches can finish inside one publication interval and
-- refusing the second would silently drop a real result.
function M.optimistic(cache, pid, delta, now_ms)
    local key = M.key(pid)
    local rec = cache.records[key]
    if not rec then return nil, "unknown-player" end
    if type(delta) ~= "table" then return nil, "no-delta" end
    -- captured BEFORE the loop mutates anything: this is the value rollback restores and confirmation compares
    -- against, and taking it after the mutation made both of them compare against the incremented number
    local before = shallow(rec)
    local pending = find_pending(cache, key)
    local applied, touched, skipped = {}, 0, 0
    for k, d in pairs(delta) do
        if k ~= "pid" and type(d) == "number" then
            if type(rec[k]) == "number" then
                rec[k] = rec[k] + d
                applied[k] = d
                touched = touched + 1
            else
                skipped = skipped + 1
            end
        end
    end
    if touched == 0 then return nil, "nothing-applied" end
    if pending then
        for k, d in pairs(applied) do
            pending.delta[k] = (pending.delta[k] or 0) + d
            pending.applied[k] = (pending.applied[k] or 0) + d
        end
        pending.at_ms = now_ms
        return shallow(rec), nil, pending
    end
    cache.seq = cache.seq + 1
    local entry = {
        pid = key, seq = cache.seq, before = before, delta = shallow(delta),
        applied = applied, at_ms = now_ms, skipped = skipped,
    }
    cache.pending[#cache.pending + 1] = entry
    return shallow(rec), nil, entry
end

-- The authority accepted it: the value already in the cache is truth now, so only the pending mark goes.
function M.ack(cache, pid)
    local _, i = find_pending(cache, M.key(pid))
    if not i then return false end
    table.remove(cache.pending, i)
    return true
end

-- The authority refused it: put back exactly what was there.
function M.rollback(cache, pid)
    local p, i = find_pending(cache, M.key(pid))
    if not p then return false, "no-pending" end
    cache.records[p.pid] = p.before
    table.remove(cache.pending, i)
    return true
end

-- A key for one finished match. `ms` is the match's own timestamp from the publisher, so the same match seen
-- on two polls is the same key, and two matches between the same pair are not.
function M.result_key(m)
    if type(m) ~= "table" then return nil end
    local p0, p1, w = tonumber(m.pid0), tonumber(m.pid1), tonumber(m.winner)
    if not (p0 and p1 and w) then return nil end
    local ms = tonumber(m.ms) or 0
    return string.format("%d:%d:%d:%d", p0, p1, w, ms)
end

-- Fast path for one published match: wins/games for the winner, games for the loser, games for a draw,
-- nothing at all for a player the cache has not seen (reported, and remembered so a later record cannot
-- retro-apply a match that was already counted as history).
function M.apply_result(cache, m, now_ms)
    local key = M.result_key(m)
    if not key then return nil, "not-a-result" end
    if cache.seen[key] then return nil, "already-seen" end
    remember(cache, key)
    local winner = tonumber(m.winner)
    local pid0, pid1 = M.key(tonumber(m.pid0)), M.key(tonumber(m.pid1))
    local d0 = { games = 1 }
    local d1 = { games = 1 }
    if winner == 0 then d0.wins = 1 elseif winner == 1 then d1.wins = 1 end
    local _, why0 = M.optimistic(cache, pid0, d0, now_ms)
    local _, why1 = M.optimistic(cache, pid1, d1, now_ms)
    return {
        key = key, pid0 = pid0, pid1 = pid1, winner = winner,
        applied0 = why0 == nil, applied1 = why1 == nil,
        why0 = why0, why1 = why1,
    }
end

-- First poll: load the ladder, and remember the ticker WITHOUT replaying it. Those matches already happened;
-- counting them as fresh wins on a cold start would invent a burst of results nobody just played.
function M.boot(cache, records, recent)
    local loaded = 0
    for _, record in ipairs(records or {}) do
        if type(record) == "table" and M.put(cache, record) then loaded = loaded + 1 end
    end
    for _, m in ipairs(recent or {}) do
        local key = M.result_key(m)
        if key then remember(cache, key) end
    end
    cache.booted = true
    return loaded
end

-- Authority truth replaces the cache. A pending write the authority answered is either CONFIRMED (its numbers
-- agree with what we applied) or a CONFLICT (we were ahead and it disagreed). A pending write it did not
-- mention survives until the TTL, then reverts.
function M.reconcile(cache, server_records, now_ms)
    local report = { written = 0, confirmed = 0, conflicts = 0, expired = 0, kept = 0 }
    local by_key = {}
    for _, sr in ipairs(server_records or {}) do
        if type(sr) == "table" then
            local key = M.key(sr.pid)
            if key and key ~= "" then by_key[key] = sr end
        end
    end

    local function agrees(pending, server_record)
        for field, delta in pairs(pending.applied or {}) do
            local before = tonumber(pending.before[field]) or 0
            if tonumber(server_record[field]) ~= before + delta then return false end
        end
        return true
    end

    local surviving = {}
    for _, p in ipairs(cache.pending) do
        local sr = by_key[p.pid]
        if sr then
            if agrees(p, sr) then report.confirmed = report.confirmed + 1
            else report.conflicts = report.conflicts + 1 end
        elseif (now_ms - p.at_ms) &lt;= M.PENDING_TTL_MS then
            surviving[#surviving + 1] = p
            report.kept = report.kept + 1
        else
            cache.records[p.pid] = p.before
            report.expired = report.expired + 1
        end
    end
    cache.pending = surviving
    for key, sr in pairs(by_key) do
        cache.records[key] = shallow(sr)
        report.written = report.written + 1
    end
    return report
end

-- Interface fan-out: the cache is written once, every reader is told. One sink throwing is reported and the
-- rest still run -- a scoreboard that cannot draw must not stop the match from being recorded.
function M.fan_out(cache, pids, sinks)
    local report = { ok = 0, failed = {} }
    for _, pid in ipairs(pids or {}) do
        local rec = cache.records[M.key(pid)]
        if rec then
            for _, sink in ipairs(sinks or {}) do
                local called, err = pcall(sink.write, shallow(rec))
                if called then
                    report.ok = report.ok + 1
                else
                    report.failed[#report.failed + 1] = { name = sink.name or "?", pid = M.key(pid), err = tostring(err) }
                end
            end
        end
    end
    return report
end

-- Fan-in for the two authorities, in authority order (IDUNA first, then WOTAN). A field only one carries is
-- taken from it; a field they disagree on keeps the higher-authority value and is reported, because averaging
-- two authorities is how a cache starts making up numbers.
function M.merge_sources(sources)
    local out, conflicts = {}, {}
    for _, src in ipairs(sources or {}) do
        for _, rec in ipairs(src.records or {}) do
            local key = type(rec) == "table" and M.key(rec.pid) or nil
            if key and key ~= "" then
                local acc = out[key]
                if not acc then
                    out[key] = shallow(rec)
                else
                    for k, v in pairs(rec) do
                        if k ~= "pid" then
                            if acc[k] == nil then
                                acc[k] = v
                            elseif acc[k] ~= v then
                                conflicts[#conflicts + 1] = {
                                    pid = key, field = k, kept = acc[k], ignored = v, source = src.name or "?",
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    return out, conflicts
end

return M
