# Ignore build artifacts
bin/
obj/
release_server/
release_client/
*.exe
*.dll
*.o
*.a
*.so
*.zip

# Bazel output symlinks/dirs (build outputs, not source)
bazel-*
__pycache__/
*.pyc

# Ignore Colab/Jupyter garbage
.ipynb_checkpoints/

# Ignore local config
.ssh/

# Compiled test/server binaries built at repo root.
run_tests
run_server_test
run_integration
run_stuffing
/server-go
/emily-bot

# ragdoll_spike (tools/ragdoll_spike/) is a throwaway CLI, not shippable code -- its compiled
# binary and generated .gband oracle clips are build artifacts, not source.
tools/ragdoll_spike/ragdoll_spike
tools/ragdoll_spike/output/
a.out

# Go module cache (appears when GOPATH is set to repo root).
pkg/

# Real, live systemd unit log output (ops/systemd/shankpit-server.service's own
# StandardOutput/StandardError append targets, S459-34) -- runtime data, not source.
var/logs/

# Claude Code session directory.
.claude/