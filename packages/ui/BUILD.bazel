load("@rules_cc//cc:defs.bzl", "cc_library")

# menu.prn -- PARENA's own stdlib/ui/menu.prn, committed RIGHT HERE beside the C it produces.
# That co-location is the whole point of PARENA's own bazel/parena_compile.bzl (kanban
# PX-001/PX-BZ-001: "we need to add support to commit the .prn file right in the same directory
# as the generated output ... not sure how that would work with bazel"). The source of truth for
# the grid-menu logic is now a file in this package, not a path inside a sibling checkout.
#
# Two real consumers, deliberately kept working side by side:
#   * scripts/gen_ui_menu.sh rewrites the CHECKED-IN menu_gen.c for the Makefile path (a normal
#     `make lobby` never needs PARENA, same as before).
#   * this genrule is the same step as a real Bazel action, so `bazel build` regenerates from
#     menu.prn every time and cannot silently drift from it.
# It is written as a plain genrule rather than PARENA's `parena_compile_c` macro because of the
# sed below, which the macro has no slot for (and which gen_ui_menu.sh already performs for the
# identical reason): `parena build` unconditionally emits `#include "parena_runtime.h"`, but
# menu.prn is scalar-only (I32/F64 in, I32 out -- no Arena, no Vec, no Bytes), so keeping the
# include would drag SDL2/POSIX headers into a package that has no business needing them.
genrule(
    name = "menu_gen_from_prn",
    srcs = ["menu.prn"],
    outs = ["menu_gen_bazel.c"],
    tools = ["@parena//src:parena"],
    cmd = " ".join([
        "$(location @parena//src:parena) build $(location menu.prn) -o $@ &&",
        "sed -i 's|^#include \"parena_runtime.h\"$$|/* PARENA stdlib/ui/menu.prn: scalar-only, runtime not needed */|' $@",
    ]),
)

# hdrs-only, deliberately including ui_bridge.c: apps/lobby/src/main.c #includes ui_bridge.c
# directly as TEXT (a unity-build-style include, not a separate translation unit) -- confirmed
# against the real Makefile's own LOBBY_SRC, which never lists ui_bridge.c as a compiled source.
# Bazel doesn't care about the .c extension in hdrs; it only needs to be a declared input file
# available to whatever includes it.
# menu_gen.h is the hand-checked-in declaration block scripts/gen_ui_menu.sh writes; the Bazel
# build compiles the freshly generated :menu_gen_bazel.c against it, so a signature change in
# menu.prn breaks the build here instead of waiting for someone to re-run the script.
cc_library(
    name = "ui",
    # Migration stage (2026-11-05): every header in this package, because this BUILD file
    # predates Bazel ever running and omitted ~120 headers its own sources #include (found by
    # compiling each package in the sandbox: e.g. packages/render/retro_sky.h needs
    # retro_sky_eval.h, which was never declared). Tighten to per-target lists once every
    # target here is known to build; the glob keeps the real compile inputs visible today.
    srcs = [":menu_gen_bazel.c"],
    hdrs = glob(["*.h"]) + ["ui_bridge.c"],
    visibility = ["//visibility:public"],
)
