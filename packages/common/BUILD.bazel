load("@rules_cc//cc:defs.bzl", "cc_library")

# common_headers -- every file in packages/common is header-only (no real .c file exists in this
# directory), so this is a pure hdrs-only cc_library: the real Bazel-native way to make a set of
# headers a declared input other cc_library/cc_binary targets can #include (matching every real
# apps/*'s own relative-path #include, e.g. "../../../packages/common/physics.h").
cc_library(
    name = "common_headers",
    # Migration stage (2026-11-05): every header in this package, because this BUILD file
    # predates Bazel ever running and omitted ~120 headers its own sources #include (found by
    # compiling each package in the sandbox: e.g. packages/render/retro_sky.h needs
    # retro_sky_eval.h, which was never declared). Tighten to per-target lists once every
    # target here is known to build; the glob keeps the real compile inputs visible today.
    hdrs = glob(["*.h"], allow_empty = True),
    # protocol.h now #includes day_night_clock.h directly (ServerState.story_clock, EMILY/
    # BACKLOG.md SECTION 536 follow-up "server-authoritative day/night sync") -- every consumer of
    # protocol.h needs that header available in its own sandboxed compile, hence this dep even
    # though most consumers never call day_night_clock_tick/init themselves (only apps/lobby and
    # apps/server actually do -- they already depend on :day_night_clock directly for the .c
    # implementation/link step; this dep exists purely so the header resolves everywhere else).
    deps = ["//packages/simulation:day_night_clock"],
    visibility = ["//visibility:public"],
)
