;; packages/sim/fall_rules.prn -- the first motion: a body leaving the spawner under gravity.
;;
;; Every number here is an integer, deliberately. The Vec/Arena physics port in
;; packages/physics_parena cannot be instantiated in this build at all (its emitted C calls arena_new /
;; bytes_*, which this runtime does not define -- see docs/PARENA_GAPS.md 5), and (f32 x) does not link
;; either (same document, 3). So the integration is done in millimetres and milliseconds: gravity is
;; 9800 mm/s^2, the step is the loop's own 16 ms, and the per-tick velocity change is one integer
;; division. The error that costs is stated where it happens rather than hidden.
;;
;; This is not 460's movement code and does not pretend to be: 460 integrates in F32 with double
;; gravity per tick, a jump arc, friction and slide. What is shared is the tick rate.
(module shankpit/fall)
(export gravity-milli dt-ms gravity-per-tick fall-vy fall-y floor-y resting-y floor-honoured)

;; 9.8 m/s^2, in mm/s^2.
(defn gravity-milli [] : I32 9800)

;; The simulation step. Boot asserts this equals packages/frame's tick-ms before it trusts a fall.
(defn dt-ms [] : I32 16)

;; mm/s of velocity gained per tick: g * dt. Integer division truncates 156.8 to 156, so a body falls
;; ~0.5% slower than the real constant over a long fall -- written down here so it is a known cost, not a
;; surprise in a replay.
(defn gravity-per-tick [] : I32 (/ (* (gravity-milli) (dt-ms)) 1000))

;; downward speed (negative, mm/s) after n ticks from rest
(defn fall-vy [(ticks : I32)] : I32
  (loop [i 0 vy 0]
    (if (< i ticks)
      (recur (+ i 1) (- vy (gravity-per-tick)))
      vy)))

;; height (mm) after n ticks from a start height, integrating position with the post-gravity velocity
(defn fall-y [(y0-mm : I32) (ticks : I32)] : I32
  (loop [i 0 y y0-mm vy 0]
    (if (< i ticks)
      (let [vy2 (- vy (gravity-per-tick))]
        (recur (+ i 1) (+ y (/ (* vy2 (dt-ms)) 1000)) vy2))
      y)))

;; the arena floor is y = 0 (resolve-player's own floor in physics.prn), so a body stops there
(defn floor-y [(y : I32)] : I32 (if (< y 0) 0 y))

;; the height a body actually holds at tick n: the floor wins over the integrator
(defn resting-y [(y0-mm : I32) (ticks : I32)] : I32 (floor-y (fall-y y0-mm ticks)))

;; 1 if no tick from 0..limit puts the body below the floor, 0 if any does. One integer, because the
;; invariant that matters is "nothing sinks through the arena" and it has to hold on every tick, not the
;; tick a caller happened to sample.
(defn floor-honoured [(y0-mm : I32) (limit : I32)] : I32
  (loop [i 0 ok 1]
    (if (< i limit)
      (recur (+ i 1) (if (< (resting-y y0-mm i) 0) 0 ok))
      ok)))
