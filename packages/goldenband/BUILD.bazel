load("@rules_cc//cc:defs.bzl", "cc_library")

# Bundled into one cc_library, same "always compiled/linked together, never separately, in every
# real build path this repo has" reasoning ECOWAR/REDGARDEN's own packages/goldenband already
# established -- the real Makefile's own LOBBY_SRC always lists these 4 files together as one
# unit.
cc_library(
    name = "goldenband",
    # Migration stage (2026-11-05): every header in this package, because this BUILD file
    # predates Bazel ever running and omitted ~120 headers its own sources #include (found by
    # compiling each package in the sandbox: e.g. packages/render/retro_sky.h needs
    # retro_sky_eval.h, which was never declared). Tighten to per-target lists once every
    # target here is known to build; the glob keeps the real compile inputs visible today.
    srcs = [
    ],
    hdrs = glob(["*.h"], allow_empty = True),
    deps = ["//packages/common:common_headers"],
    visibility = ["//visibility:public"],
)

# GOLDEN BAND rigid body physics + datasheet robots + reward compiler (founder real-time
# 2026-09-27: "upgrade shankpit ... to formal rigid body physics"), vendored verbatim from the
# GOLDENBAND repo's src/. A separate target from :goldenband because nothing in the lobby/server
# link line needs it yet -- consumers (packages/simulation:rigid_ragdoll, tools/rigid_ragdoll)
# depend on it explicitly.
cc_library(
    name = "grb_physics",
    # Migration stage (2026-11-05): every header in this package, because this BUILD file
    # predates Bazel ever running and omitted ~120 headers its own sources #include (found by
    # compiling each package in the sandbox: e.g. packages/render/retro_sky.h needs
    # retro_sky_eval.h, which was never declared). Tighten to per-target lists once every
    # target here is known to build; the glob keeps the real compile inputs visible today.
    srcs = [
    ],
    hdrs = glob(["*.h"], allow_empty = True),
    linkopts = ["-lm"],
    visibility = ["//visibility:public"],
)
