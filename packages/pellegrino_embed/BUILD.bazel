load("@rules_cc//cc:defs.bzl", "cc_library")

# SHANKPIT OS menu through PELLEGRINO (kanban #627). One translation unit: os_menu_embed.c #includes the
# generated engine (pellegrino_gen.inc), the vendored PARENA runtime and pg_rename.h itself, so the sources are
# deliberately all in `srcs` and only the API header is public. Written alongside the Makefile build (which is
# the verified one -- `make test-os-menu`); this Bazel target has NOT been built.
cc_library(
    name = "pellegrino_embed",
    # Migration stage (2026-11-05): every header in this package, because this BUILD file
    # predates Bazel ever running and omitted ~120 headers its own sources #include (found by
    # compiling each package in the sandbox: e.g. packages/render/retro_sky.h needs
    # retro_sky_eval.h, which was never declared). Tighten to per-target lists once every
    # target here is known to build; the glob keeps the real compile inputs visible today.
    srcs = [
        "pellegrino_gen.inc",
        "pg_rename.h",
        "runtime/parena_runtime.h",
        "runtime/aead/monocypher.h",
    ],
    hdrs = glob(["*.h"]) + [
        # textually #included by os_menu_embed.c:46 -- a staged input, not a second TU
    ],
    # os_menu_embed.c #includes "runtime/parena_runtime.c" relative to this package root.
    copts = ["-Ipackages/pellegrino_embed"],
    linkopts = ["-lSDL2"],
    visibility = ["//visibility:public"],
)
