load("@rules_cc//cc:defs.bzl", "cc_library")

# Bundled into one cc_library -- same real "a bag of files one real build path always compiles as
# one unit" reasoning packages/goldenband's own BUILD.bazel gives; the Makefile's own LOBBY_SRC
# always lists these 5 .c files together. material_shaders.h is header-only (no matching .c) --
# S459-16's own real, named native shader registry, included here since it's this package's own
# header, not compiled separately.
cc_library(
    name = "render",
    srcs = [
        "gl_shader.c",
        "proc_tex.c",
        "retro_lighting.c",
        "retro_material.c",
        "retro_sky.c",
        # sky_weather.c -- BIG_O/PARENA engine merge phase 1 (ported in from BIG_O's
        # bigo_sky.h/bigo_skycfg.h, split into a real .c/.h pair to match this package's own
        # convention). Upgrades retro_sky's fixed fast-orbit dome with a real weather-aware sky
        # (clear/overcast/rain/storm, clouds, rain, lightning), driven by
        # packages/simulation:day_night_clock. retro_sky.c/.h stay in place unchanged --
        # retro_lighting.c's RETRO_LIGHTING_DYNAMIC preset still reads it for scene ambient
        # lighting; wiring that to sky_weather's own weather state is a named EMILY/BACKLOG.md
        # SECTION 536 follow-up, not this pass.
        "sky_weather.c",
    ],
    hdrs = [
        "gl_shader.h",
        "material_shaders.h",
        "proc_tex.h",
        "retro_lighting.h",
        "retro_material.h",
        "retro_sky.h",
        "sky_weather.h",
        "sky_weather_cfg.h",
    ],
    deps = ["//packages/common:common_headers"],
    visibility = ["//visibility:public"],
)
