load("//bazel:parena.bzl", "parena_module")

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:parena.bzl", "parena_stdlib_module")

# Bundled into one cc_library -- same real "a bag of files one real build path always compiles as
# one unit" reasoning packages/goldenband's own BUILD.bazel gives; the Makefile's own LOBBY_SRC
# always lists these 5 .c files together. material_shaders.h is header-only (no matching .c) --
# S459-16's own real, named native shader registry, included here since it's this package's own
# header, not compiled separately.
cc_library(
    name = "render",
    # Migration stage (2026-11-05): every header in this package, because this BUILD file
    # predates Bazel ever running and omitted ~120 headers its own sources #include (found by
    # compiling each package in the sandbox: e.g. packages/render/retro_sky.h needs
    # retro_sky_eval.h, which was never declared). Tighten to per-target lists once every
    # target here is known to build; the glob keeps the real compile inputs visible today.
    srcs = [
        # sky_weather.c -- BIG_O/PARENA engine merge phase 1 (ported in from BIG_O's
        # bigo_sky.h/bigo_skycfg.h, split into a real .c/.h pair to match this package's own
        # convention). Upgrades retro_sky's fixed fast-orbit dome with a real weather-aware sky
        # (clear/overcast/rain/storm, clouds, rain, lightning), driven by
        # packages/simulation:day_night_clock. retro_sky.c/.h stay in place unchanged --
        # retro_lighting.c's RETRO_LIGHTING_DYNAMIC preset still reads it for scene ambient
        # lighting; wiring that to sky_weather's own weather state is a named EMILY/BACKLOG.md
        # SECTION 536 follow-up, not this pass.
    ],
    hdrs = glob(["*.h"], allow_empty = True),
    deps = [
        "//packages/common:common_headers",
        "//packages/simulation:day_night_clock",  # sky_weather.c's own real dependency
    ],
    visibility = ["//visibility:public"],
)


# ---- render rule modules, compiled from PARENA stdlib ------------------------------------------
# filter_rules.h -> stdlib/shankpit/filter_rules.prn, camera_rig.h -> camera_rules.prn,
# env_matrix.h -> lighting_rules.prn, retro_lighting.h -> ambient_rules.prn: the decision layer of
# the renderer, emitted as C in this package by the real compiler.
parena_stdlib_module(name = "filter_rules", module = "filter_rules")
parena_stdlib_module(name = "camera_rules", module = "camera_rules")
parena_stdlib_module(name = "lighting_rules", module = "lighting_rules")
parena_stdlib_module(name = "ambient_rules", module = "ambient_rules")

sh_test(
    name = "render_rules_emitted_test",
    srcs = ["//bazel:parena_emitted_test.sh"],
    data = [
        ":filter_rules_from_prn",
        ":camera_rules_from_prn",
        ":lighting_rules_from_prn",
        ":ambient_rules_from_prn",
    ],
    args = [
        "$(rootpath :filter_rules_from_prn)",
        "$(rootpath :camera_rules_from_prn)",
        "$(rootpath :lighting_rules_from_prn)",
        "$(rootpath :ambient_rules_from_prn)",
    ],
)

# packages/render/palette_rules.prn -- the 460 web build's palette (see its header for why this is a
# transcription of PARENA/stdlib/shankpit460/sp_view.prn rather than a build of it). The .prn is also
# exported because apps/boot compiles it into its own translation unit.
exports_files(["palette_rules.prn"])

parena_module(
    name = "palette_rules",
    src = "palette_rules.prn",
)

# packages/render/sky_rules.prn -- 460's sky-row arithmetic, without the framebuffer write. Exported so
# apps/boot can compile it into its own translation unit.
exports_files(["sky_rules.prn"])

parena_module(
    name = "sky_rules",
    src = "sky_rules.prn",
)

sh_test(
    name = "render_460_rules_emitted_test",
    srcs = ["//bazel:parena_emitted_test.sh"],
    data = [
        ":palette_rules_from_prn",
        ":sky_rules_from_prn",
    ],
    args = [
        "$(rootpath :palette_rules_from_prn)",
        "$(rootpath :sky_rules_from_prn)",
    ],
)
