;; packages/simulation/slide_rules.prn -- the slope half of the crouch-slide, written in PARENA.
;;
;; Clean-room: the spec is this package's own slide_rules.h, whose comment block pins every number
;; (steep = three times the tilt, saturating at ~48 degrees; align is the host's downhill dot
;; product already scaled to 0..1000; the cap is 1200 milli-units/tick; flat is >= 990 and earns
;; nothing; a full-steep face keeps 300 permille of the slide's own drag, flat keeps all of it).
;; No C was read to write this -- the header is the contract, and the header's own static defaults
;; are what a test compares against.
;;
;; Scalar-only on purpose (I32 in, I32 out -- no Arena, Vec or Bytes), so the emitted C needs no
;; runtime and this compiles in every package that has an opinion about a hillside.
(module shankpit/slide-rules)
(export slide-rules-clamp slide-rules-steep slide-rules-align
        slide-rules-accel slide-rules-scrub slide-rules-cap)

(defn slide-rules-clamp [(lo : I32) (hi : I32) (x : I32)] : I32
  (if (< x lo) lo (if (> x hi) hi x)))

;; 0..1000: how steep is this face. Three times the tilt, saturating.
(defn slide-rules-steep [(normal-y-permille : I32)] : I32
  (slide-rules-clamp 0 1000
    (* (- 1000 (slide-rules-clamp 0 1000 normal-y-permille)) 3)))

;; 0..1000: how much the body points downhill. 0 means across the hill or straight up it.
(defn slide-rules-align [(downhill-dot-permille : I32)] : I32
  (slide-rules-clamp 0 1000 downhill-dot-permille))

;; Units/tick x 1000. Above the engine's own sprint speed on purpose: a hill is the one way to
;; outrun one. The host clamps velocity to this.
(defn slide-rules-cap [] : I32 1200)

;; Permille of the host's base per-tick acceleration. Constant with speed, like gravity: a tapered
;; pull loses to the slide's own scrub near the cap and a downhill slide still slows down.
(defn slide-rules-accel
  [(normal-y-permille : I32) (downhill-dot-permille : I32) (speed-milli : I32)] : I32
  (if (>= (slide-rules-clamp 0 1000 normal-y-permille) 990)
    0
    (if (>= (slide-rules-clamp 0 (slide-rules-cap) speed-milli) (slide-rules-cap))
      0
      (slide-rules-clamp 0 1000
        (/ (* (slide-rules-steep normal-y-permille)
              (slide-rules-align downhill-dot-permille))
           1000)))))

;; Permille of the existing slide drag to KEEP. Flat keeps 1000 (unchanged); a full-steep face
;; keeps 300, or the scrub would eat exactly what the slope just added.
(defn slide-rules-scrub [(normal-y-permille : I32)] : I32
  (slide-rules-clamp 300 1000
    (- 1000 (/ (* (slide-rules-steep normal-y-permille) 700) 1000))))
