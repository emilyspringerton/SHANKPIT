load("@rules_cc//cc:defs.bzl", "cc_library")

# day_night_clock.c/world_rules.c -- BIG_O/PARENA engine merge phase 1 (founder real-time: "port
# the BIG_O tech into the shankpit repo -- all of it the lighting the systems all of it"). Real
# day/night + weather clock; world_rules.c is PARENA-generated (from PARENA/stdlib/shankpit/
# world_rules.prn, itself copied verbatim from PARENA/stdlib/big_o/world_rules.prn -- the logic is
# identical, SHANKPIT now owns its own stdlib domain). Deliberate v0 scope cut vs. BIG_O's own
# World: no zombie population/Sim coupling -- see day_night_clock.h's own header for the real,
# named reasoning. Server-authoritative for MODE_STORY/MODE_STORY_CAVE as of the EMILY/BACKLOG.md
# SECTION 536 follow-up ("server-authoritative day/night sync"): apps/server now ticks and
# broadcasts it (PACKET_WORLD_CLOCK) too, not just apps/lobby's own local-match/fallback tick.
cc_library(
    name = "day_night_clock",
    srcs = [
        "day_night_clock.c",
        "world_rules.c",
    ],
    hdrs = [
        "day_night_clock.h",
        "parena_runtime.h",  # world_rules.c's own real dependency (minimal Arena/Vec/Bytes runtime)
    ],
    visibility = ["//visibility:public"],
)

# witness_ai.c and its 5 real dependencies -- BIG_O engine merge SECTION 536 phases 2/3/7a/7b/7d
# ("full phone app parity, costume changes, add The Men" follow-up). Bundled into one cc_library,
# same "always compiled/linked together, never separately" reasoning packages/goldenband's own
# BUILD.bazel already established -- the Makefile's own LOBBY_SRC and SERVER_SRC both always list
# all 6 together. A real, separate target from :story_ai (not folded directly into it) because it
# has its own real, narrower dep surface (needs //packages/world for level_boxes.h's
# level_boxes_zone_for_position, :story_ai does not) -- :story_ai depends on this one below instead,
# matching local_game.h's own real #include "witness_ai.h" (this Bazel build's own previously-
# missing gap: Bazel never compiled this file at all until this fix, confirmed live via a real
# `bazel build` -- `fatal error: humanness.h: No such file or directory` compiling story_ai.c,
# since neither ai_nav.c/humanness.c NOR this whole family were ever wired into this file).
cc_library(
    name = "witness_ai",
    srcs = [
        "ai_brain_rules.c",
        "giant_bug_brain.c",  # PARENA-generated (giant_bug_brain.prn) -- witness_ai.c's own real dep
        "giant_bug_values.c",  # Giant Zombie Bug value system, both client+server per SERVER_SRC/LOBBY_SRC
        "npc_archetype.c",
        "witness_ai.c",
        "witness_rules.c",
        "witness_sim.c",
        "zombie_values.c",
    ],
    hdrs = [
        "giant_bug_values.h",
        "humanness.h",  # npc_archetype.h's own real dependency
        "npc_archetype.h",
        "witness_ai.h",
        "witness_live.h",
        "witness_sim.h",
        "zombie_values.h",
    ],
    deps = [
        "//packages/common:common_headers",
        "//packages/world",  # witness_ai.h's own real level_boxes.h dependency (7c zone sync)
    ],
    visibility = ["//visibility:public"],
)

# Real, deliberate two-target split -- NOT a single bundle. The Makefile's own real SERVER_SRC
# lists ONLY story_ai.c (+ ai_nav.c/humanness.c/the witness_ai family below), while LOBBY_SRC adds
# cutscene.c + typing_lesson.c on top. Bundling this whole directory into one cc_library (the
# packages/goldenband/packages/render precedent) would pull cutscene.c/typing_lesson.c into the
# server binary, which the real Makefile never does -- an unfaithful migration.
# cutscene_effect_mod.c/cutscene_effect_mod_test.c are genuinely unreferenced anywhere in the real
# Makefile, CI workflows, or scripts (grepped for), so they are deliberately excluded here too,
# matching current real build coverage rather than inventing new. ai_nav.c/humanness.c bundled
# directly into this target's own srcs (not a separate cc_library) since story_ai.c calls straight
# into both and both LOBBY_SRC/SERVER_SRC always compile all three together -- no real scenario
# builds one without the other two.
cc_library(
    name = "story_ai",
    srcs = [
        "ai_nav.c",
        "humanness.c",
        "story_ai.c",
    ],
    hdrs = [
        "ai_nav.h",
        "bot_ai.h",
        "brain_weights.h",
        "game_physics.h",
        "humanness.h",
        "local_game.h",
        "neural_net.h",
        "parena_runtime.h",
        "story_ai.h",
        "story_buttons.h",  # S485, REFLUX pub/sub buttons -- header-only, included by local_game.h
    ],
    deps = [
        "//packages/common:common_headers",
        "//packages/reflux",
        ":witness_ai",  # local_game.h's own real #include "witness_ai.h"
    ],
    visibility = ["//visibility:public"],
)

# world_alerts_mod.c/world_alert_bridge.c -- BIG_O engine merge phase 6 (the phone's real event
# pipeline). Deliberately its own target, NOT folded into :story_ai or :simulation below -- the
# Makefile's own LOBBY_SRC lists both, but SERVER_SRC lists neither (client-local only, same
# "phone.h's own real WARDROBE/STATUS UI has no server-authoritative story yet" scope cut phase
# 6/7e's own doc comments already name). apps/lobby depends on this directly.
cc_library(
    name = "world_alert_bridge",
    srcs = [
        "world_alert_bridge.c",
        "world_alerts_mod.c",
    ],
    hdrs = ["world_alert_bridge.h"],
    deps = [
        "//packages/common:common_headers",  # phone.h
        "//packages/reflux",  # REFLUX_ACTION_PHASE_CHANGED/WEATHER_CHANGED
        ":day_night_clock",
    ],
    visibility = ["//visibility:public"],
)

# food_pickup.c -- BIG_O food system follow-up ("basic food system pickup and use (cargo)").
# Client-local only, same real "phone.h's own real WARDROBE/STATUS UI has no server-authoritative
# story yet" scope cut :world_alert_bridge above already names -- the Makefile's own LOBBY_SRC
# lists it, SERVER_SRC does not.
cc_library(
    name = "food_pickup",
    srcs = ["food_pickup.c"],
    hdrs = ["food_pickup.h"],
    deps = [
        "//packages/common:common_headers",  # food_items.h
    ],
    visibility = ["//visibility:public"],
)

# Bundled cutscene.c + typing_lesson.c, same real "always compiled together in this one real build
# path" reasoning as packages/goldenband/packages/render -- the Makefile's own LOBBY_SRC always
# lists both alongside story_ai.c. Depends on :story_ai so apps/lobby pulls it in transitively
# rather than listing both simulation targets itself.
cc_library(
    name = "simulation",
    srcs = [
        "cutscene.c",
        "typing_lesson.c",
    ],
    hdrs = [
        "cutscene.h",
        "typing_lesson.h",
    ],
    deps = [
        ":story_ai",
        "//packages/common:common_headers",
    ],
    visibility = ["//visibility:public"],
)
