# The clean-room rewrite starts here: slide_rules.prn sits in this package beside the header that
# specifies it, and the C is emitted by the real PARENA compiler on every build.
parena_module(name = "slide_rules", src = "slide_rules.prn")

# `bazel test` on the emission contract: the compiler really produced this module's C, the
# exports are in it, and the scalar-only strip kept the runtime (and SDL2) out of the package.
sh_test(
    name = "slide_rules_emitted_test",
    srcs = ["slide_rules_emitted_test.sh"],
    data = [":slide_rules_from_prn"],
    args = ["$(rootpath :slide_rules_from_prn)"],
)


# ---- engine rule modules, compiled from PARENA stdlib -------------------------------------------
# packages/simulation/*.h each name the stdlib file their numbers live in (e.g. wave_rules.h says
# "PARENA/stdlib/shankpit/wave_rules.prn"). These are those modules, compiled into this package by
# the real compiler on every build -- the pure-logic half of the engine, back without a single
# checked-in .c.
parena_stdlib_module(name = "world_rules", module = "world_rules")
parena_stdlib_module(name = "zombie_brain_rules", module = "zombie_brain_rules")
parena_stdlib_module(name = "brick_rules", module = "brick_rules")
parena_stdlib_module(name = "ai_brain_rules", module = "ai_brain_rules")
parena_stdlib_module(name = "zone_rules", module = "zone_rules")
parena_stdlib_module(name = "wave_rules", module = "wave_rules")

