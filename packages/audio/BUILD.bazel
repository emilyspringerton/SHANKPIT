load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:parena.bzl", "parena_stdlib_module")

cc_library(
    name = "audio",
    # Migration stage (2026-11-05): every header in this package, because this BUILD file
    # predates Bazel ever running and omitted ~120 headers its own sources #include (found by
    # compiling each package in the sandbox: e.g. packages/render/retro_sky.h needs
    # retro_sky_eval.h, which was never declared). Tighten to per-target lists once every
    # target here is known to build; the glob keeps the real compile inputs visible today.
    srcs = glob(["*.c"], allow_empty = True),
    hdrs = glob(["*.h"], allow_empty = True),
    copts = ["-Wno-unused-parameter"],
    linkopts = ["-lm"],
    deps = ["//packages/common:common_headers"],
    visibility = ["//visibility:public"],
)
parena_stdlib_module(name = "weather_audio_rules", module = "weather_audio_rules")
parena_stdlib_module(name = "siren_rules", module = "siren_rules")
parena_stdlib_module(name = "icecream_rules", module = "icecream_rules")

sh_test(
    name = "audio_emitted_test",
    srcs = ["//bazel:parena_emitted_test.sh"],
    data = [
        ":weather_audio_rules_from_prn",
        ":siren_rules_from_prn",
        ":icecream_rules_from_prn",
    ],
    args = [
        "$(rootpath :weather_audio_rules_from_prn)",
        "$(rootpath :siren_rules_from_prn)",
        "$(rootpath :icecream_rules_from_prn)",
    ],
)
