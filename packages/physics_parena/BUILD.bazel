load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:parena.bzl", "parena_stdlib_module")

# Adds the package to the Bazel graph: the fork keeps these headers, and a header-only library is
# what makes them declared inputs for anything that includes them.
cc_library(
    name = "physics_parena",
    srcs = glob(["*.c"], allow_empty = True),
    hdrs = glob(["*.h"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# physics.prn and movement.prn are Vec/Arena modules: their emitted C keeps the
# `#include "parena_runtime.h"` (strip_runtime = False) and links the real runtime, which is a
# declared dep rather than a header that happens to be on the box.
parena_stdlib_module(
    name = "physics",
    module = "physics",
    strip_runtime = False,
    deps = ["@parena//runtime:parena_runtime"],
)
parena_stdlib_module(
    name = "movement",
    module = "movement",
    strip_runtime = False,
    deps = ["@parena//runtime:parena_runtime"],
)
